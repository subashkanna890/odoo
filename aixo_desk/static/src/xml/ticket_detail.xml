<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="aixo_desk.TicketDetail">
    <div t-if="state.loading and !state.data" class="ax-empty ax-empty-lg">Loading ticket…</div>
    <div t-if="state.data" class="ax-detail">

        <!-- ===================================================== switcher -->
        <aside class="ax-switcher" aria-label="Tickets">
            <div class="ax-switcher-head">
                <a href="/desk" class="ax-linkbtn"><Icon name="'chevronRight'" size="12"/> All tickets</a>
                <label class="ax-searchbox ax-searchbox-sm"><Icon name="'search'" size="14"/>
                    <input type="search" placeholder="Search" aria-label="Search tickets" t-model="state.switchSearch"/>
                </label>
            </div>
            <button type="button" t-foreach="switcher" t-as="t" t-key="t.id" class="ax-switch-item" t-att-class="{'is-on': t.id === state.id}" t-on-click="() => this.open(t)">
                <span class="ax-switch-top"><strong t-out="t.subject"/></span>
                <span class="ax-switch-meta">#<t t-out="t.number"/> · <t t-out="t.contact"/></span>
                <span class="ax-switch-meta"><span t-att-class="{'ax-overdue': t.overdue}"><t t-out="t.due"/></span></span>
                <span class="ax-switch-bottom">
                    <span t-attf-class="ax-chip {{ statusClass[t.state] }}" t-out="t.state_label"/>
                    <span t-if="t.owner" class="ax-avatar ax-avatar-sm" t-att-style="'background:' + t.owner.bg + ';color:' + t.owner.fg" t-out="t.owner.initials"/>
                    <span t-else="" class="ax-avatar ax-avatar-sm ax-avatar-empty">+</span>
                </span>
            </button>
        </aside>

        <!-- ========================================================== main -->
        <main class="ax-detail-main">
            <div class="ax-detail-head">
                <div class="ax-detail-title">
                    <h1><t t-out="ticket.subject"/></h1>
                    <p>#<t t-out="ticket.number"/> · <t t-out="state.data.contact.name"/><t t-if="state.data.contact.account"> · <t t-out="state.data.contact.account"/></t> · <span t-att-class="{'ax-overdue': ticket.overdue}">Due <t t-out="ticket.due or 'not set'"/></span></p>
                </div>
                <div class="ax-detail-actions">
                    <div class="ax-sla" t-att-class="sla.cls" role="status" aria-live="off">
                        <span class="ax-sla-chip" t-out="sla.chip"/><span t-out="sla.text"/>
                    </div>
                    <button type="button" class="ax-timer" t-att-class="{'is-running': state.data.timer.running}" t-att-aria-label="state.data.timer.running ? 'Pause timer' : 'Start timer'" t-att-disabled="ticket.closed" t-on-click="toggleTimer">
                        <svg width="12" height="12" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true"><path t-att-d="state.data.timer.running ? 'M2 1h3v10H2zM7 1h3v10H7z' : 'M2 1l9 5-9 5z'"/></svg>
                        <span class="ax-mono" t-out="timerText"/>
                    </button>
                    <button type="button" t-if="!ticket.closed" class="ax-btn ax-btn-ghost" t-on-click="openClose">Close Ticket</button>
                    <button type="button" t-else="" class="ax-btn ax-btn-dark" t-on-click="reopen">Reopen Ticket</button>
                </div>
            </div>

            <div class="ax-tabs" role="tablist">
                <button type="button" role="tab" t-foreach="tabs" t-as="tab" t-key="tab[0]" t-att-aria-selected="state.tab === tab[0]" t-att-class="{'is-on': state.tab === tab[0]}" t-on-click="() => state.tab = tab[0]" t-out="tabLabel(tab[0], tab[1])"/>
            </div>

            <!-- ======================================== conversations -->
            <section t-if="state.tab === 'conv'" class="ax-panel-body" aria-label="Conversations">
                <div t-if="state.prefs.dvp2" class="ax-ai-card">
                    <button type="button" class="ax-ai-head" t-att-aria-expanded="state.sections.ai" t-on-click="() => this.toggleSection('ai')">
                        <Icon name="'sparkle'" size="16"/><strong>AI summary</strong><span class="ax-spacer"/><Icon name="state.sections.ai ? 'chevronUp' : 'chevronDown'" size="14"/>
                    </button>
                    <div t-if="state.sections.ai" class="ax-ai-body">
                        <p t-if="state.summary" t-out="state.summary.summary"/>
                        <p t-else="" class="ax-hint">Summarising…</p>
                        <p t-if="state.summary and state.summary.deadline" class="ax-hint">Deadline mentioned: <strong t-out="state.summary.deadline"/></p>
                    </div>
                </div>

                <div class="ax-composer-bar" t-if="!state.composing">
                    <button type="button" class="ax-btn ax-btn-dark" t-on-click="() => this.openComposer(false)"><Icon name="'reply'" size="16"/> Reply</button>
                    <button type="button" class="ax-btn ax-btn-ghost" t-on-click="() => this.openComposer(true)">Add note</button>
                </div>
                <div t-else="" class="ax-composer" id="reply">
                    <div class="ax-composer-top">
                        <div class="ax-seg-sm" role="tablist">
                            <button type="button" t-att-class="{'is-on': !state.internal}" t-on-click="() => state.internal = false">Reply</button>
                            <button type="button" t-att-class="{'is-on': state.internal}" t-on-click="() => state.internal = true">Internal note</button>
                        </div>
                        <span t-if="!state.internal" class="ax-hint">To: <strong t-out="state.data.contact.name"/> &lt;<t t-out="state.data.contact.email or 'no email'"/>&gt;</span>
                        <span t-else="" class="ax-hint">Only employees see notes. Use @name to mention a colleague.</span>
                    </div>
                    <textarea t-ref="composer" class="ax-input ax-textarea" rows="7" aria-label="Message" t-model="state.draft" placeholder="Write your reply…"/>
                    <div t-if="state.pending.length" class="ax-pending">
                        <span t-foreach="state.pending" t-as="a" t-key="a.id" class="ax-file-chip">
                            <Icon name="'attach'" size="12"/><t t-out="a.name"/>
                            <button type="button" aria-label="Remove attachment" t-on-click="() => this.removePending(a)"><Icon name="'close'" size="12"/></button>
                        </span>
                    </div>
                    <div class="ax-suggest" t-if="!state.internal">
                        <span><Icon name="'sparkle'" size="14"/> AI suggests</span>
                        <button type="button" t-foreach="state.data.macros.filter((m) => m.suggest)" t-as="m" t-key="m.id" class="ax-chip-btn" t-on-click="() => this.useMacro(m)" t-out="m.name"/>
                    </div>
                    <div class="ax-composer-foot">
                        <input type="file" multiple="multiple" t-ref="file" hidden="hidden" t-on-change="upload"/>
                        <button type="button" class="ax-btn ax-btn-ghost" t-att-disabled="state.uploading" t-on-click="pickFiles"><Icon name="'attach'" size="14"/> <t t-out="state.uploading ? 'Uploading…' : 'Attach'"/></button>
                        <span class="ax-spacer"/>
                        <button type="button" class="ax-btn ax-btn-ghost" t-on-click="closeComposer">Cancel</button>
                        <button type="button" class="ax-btn ax-btn-dark" t-att-disabled="state.sending" t-on-click="send"><t t-out="state.internal ? 'Add note' : 'Send'"/></button>
                    </div>
                </div>

                <article t-foreach="messages" t-as="m" t-key="m.id" class="ax-msg" t-att-class="{'is-note': m.internal}">
                    <span class="ax-avatar" t-att-style="'background:' + m.author.bg + ';color:' + m.author.fg" t-out="m.author.initials"/>
                    <div class="ax-msg-main">
                        <header><strong t-out="m.author.name"/><span t-if="m.internal" class="ax-chip is-hold">Internal note</span><small t-out="m.date"/></header>
                        <div class="ax-msg-body" t-out="markup(m.body)"/>
                        <div t-if="m.attachments.length" class="ax-pending">
                            <a t-foreach="m.attachments" t-as="a" t-key="a.id" t-att-href="a.url" class="ax-file-chip"><Icon name="'attach'" size="12"/><t t-out="a.name"/></a>
                        </div>
                    </div>
                </article>
                <article class="ax-msg">
                    <span class="ax-avatar" t-att-style="'background:' + state.data.contact.bg + ';color:' + state.data.contact.fg" t-out="state.data.contact.initials"/>
                    <div class="ax-msg-main">
                        <header><strong t-out="state.data.contact.name"/><small>Original request</small></header>
                        <div class="ax-msg-body" t-out="markup(ticket.description)"/>
                    </div>
                </article>
            </section>

            <!-- =========================================== resolution -->
            <section t-if="state.tab === 'res'" class="ax-panel-body" aria-label="Resolution">
                <div t-if="ticket.closed" class="ax-resolution">
                    <h3>Resolution</h3>
                    <div t-out="markup(ticket.resolution)"/>
                    <p t-if="ticket.rating" class="ax-hint">Customer rating: <strong t-out="ticket.rating"/></p>
                </div>
                <div t-else="" class="ax-empty">
                    <strong>This ticket is not resolved yet.</strong>
                    <span>Close it with a resolution summary when the issue is fixed.</span>
                    <button type="button" class="ax-btn ax-btn-dark" t-on-click="openClose">Close Ticket</button>
                </div>
            </section>

            <!-- ======================================== time entries -->
            <section t-if="state.tab === 'time'" class="ax-panel-body" aria-label="Time entries">
                <div class="ax-composer-bar">
                    <button type="button" class="ax-btn ax-btn-dark" t-on-click="newEntry"><Icon name="'plus'" size="14"/> Add time entry</button>
                    <span class="ax-spacer"/><strong>Total logged: <t t-out="totalHours"/> h</strong>
                </div>
                <div t-if="state.entry" class="ax-entry-form">
                    <input class="ax-input" aria-label="Work description" placeholder="Work description" t-model="state.entry.name"/>
                    <input class="ax-input" type="date" aria-label="Date" t-model="state.entry.date_input"/>
                    <input class="ax-input" aria-label="Hours" placeholder="Hours (1.5 or 1:30)" t-model="state.entry.hours"/>
                    <button type="button" class="ax-btn ax-btn-dark" t-on-click="saveEntry">Save</button>
                    <button type="button" class="ax-btn ax-btn-ghost" t-on-click="() => state.entry = null">Cancel</button>
                </div>
                <div t-if="!state.data.time_entries.length" class="ax-empty">No time logged yet.</div>
                <table t-else="" class="ax-table">
                    <thead><tr><th>Date</th><th>Agent</th><th>Work</th><th>Hours</th><th/></tr></thead>
                    <tbody>
                        <tr t-foreach="state.data.time_entries" t-as="e" t-key="e.id">
                            <td t-out="e.date"/><td t-out="e.agent"/><td t-out="e.name"/>
                            <td><t t-out="e.hours"/><span t-if="e.running" class="ax-chip is-open">running</span></td>
                            <td class="ax-actions">
                                <t t-if="e.mine and !e.running">
                                    <button type="button" class="ax-iconbtn" aria-label="Edit entry" t-on-click="() => this.editEntry(e)"><Icon name="'edit'" size="14"/></button>
                                    <button type="button" class="ax-iconbtn" aria-label="Delete entry" t-on-click="() => this.deleteEntry(e)"><Icon name="'trash'" size="14"/></button>
                                </t>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </section>

            <!-- ========================================== attachments -->
            <section t-if="state.tab === 'att'" class="ax-panel-body" aria-label="Attachments">
                <div class="ax-composer-bar">
                    <input type="file" multiple="multiple" t-ref="file" hidden="hidden" t-on-change="upload"/>
                    <button type="button" class="ax-btn ax-btn-dark" t-att-disabled="state.uploading" t-on-click="pickFiles"><Icon name="'attach'" size="14"/> <t t-out="state.uploading ? 'Uploading…' : 'Upload'"/></button>
                </div>
                <div t-if="!state.data.attachments.length" class="ax-empty">No attachments.</div>
                <ul t-else="" class="ax-filelist">
                    <li t-foreach="state.data.attachments" t-as="a" t-key="a.id">
                        <Icon name="'attach'" size="16"/>
                        <span><strong t-out="a.name"/><small><t t-out="formatSize(a.size)"/> · <t t-out="a.by"/> · <t t-out="a.date"/></small></span>
                        <a t-att-href="a.url" class="ax-iconbtn" t-att-aria-label="'Download ' + a.name"><Icon name="'download'" size="16"/></a>
                    </li>
                </ul>
            </section>
        </main>

        <!-- ================================================ right panel -->
        <aside class="ax-sidepanel" aria-label="Ticket details">
            <nav class="ax-rail" aria-label="Panels">
                <button type="button" t-foreach="rail" t-as="r" t-key="r[0]" t-att-class="{'is-on': state.rail === r[0]}" t-att-title="r[1]" t-att-aria-label="r[1]" t-att-aria-pressed="state.rail === r[0]" t-on-click="() => state.rail = r[0]"><Icon name="r[2]" size="18"/></button>
            </nav>
            <div class="ax-sidepanel-body">
                <h2 t-out="rail.find((r) => r[0] === state.rail)[1]"/>

                <t t-if="state.rail === 'props'">
                    <section class="ax-acc">
                        <button type="button" t-att-aria-expanded="state.sections.contact" t-on-click="() => this.toggleSection('contact')"><strong>Contact Info</strong><Icon name="state.sections.contact ? 'chevronUp' : 'chevronDown'" size="14"/></button>
                        <div t-if="state.sections.contact" class="ax-acc-body">
                            <div class="ax-contact">
                                <span class="ax-avatar" t-att-style="'background:' + state.data.contact.bg + ';color:' + state.data.contact.fg" t-out="state.data.contact.initials"/>
                                <div><strong t-out="state.data.contact.name"/><small t-out="state.data.contact.email"/><small t-out="state.data.contact.phone"/></div>
                            </div>
                            <div class="ax-stats">
                                <span><strong t-out="state.data.contact.counts.open"/>Open</span>
                                <span><strong t-out="state.data.contact.counts.on_hold"/>On hold</span>
                                <span><strong t-out="state.data.contact.counts.closed"/>Closed</span>
                            </div>
                        </div>
                    </section>
                    <section class="ax-acc">
                        <button type="button" t-att-aria-expanded="state.sections.key" t-on-click="() => this.toggleSection('key')"><strong>Key Information</strong><Icon name="state.sections.key ? 'chevronUp' : 'chevronDown'" size="14"/></button>
                        <div t-if="state.sections.key" class="ax-acc-body ax-fields">
                            <label>Ticket Owner
                                <select class="ax-input" t-on-change="(ev) => this.save({owner_id: Number(ev.target.value)})">
                                    <option value="0" t-att-selected="!ticket.owner">Unassigned</option>
                                    <option t-foreach="state.data.agents" t-as="a" t-key="a.id" t-att-value="a.id" t-att-selected="ticket.owner and ticket.owner.id === a.id" t-out="a.name"/>
                                </select>
                                <button type="button" class="ax-linkbtn" t-on-click="assignMe"><t t-out="ticket.owner and ticket.owner.id === state.data.me.id ? 'Unassign me' : 'Assign to me'"/></button>
                            </label>
                            <label>Status
                                <select class="ax-input" t-att-disabled="ticket.closed" t-on-change="(ev) => this.save({state: ev.target.value})">
                                    <option t-foreach="state.data.states.filter((s) => s.value !== 'closed' or ticket.closed)" t-as="s" t-key="s.value" t-att-value="s.value" t-att-selected="ticket.state === s.value" t-out="s.label"/>
                                </select>
                            </label>
                            <label>Priority
                                <select class="ax-input" t-on-change="(ev) => this.save({priority: ev.target.value})">
                                    <option t-foreach="priorities" t-as="p" t-key="p" t-att-value="p" t-att-selected="ticket.priority === p" t-out="priorityLabel[p]"/>
                                </select>
                            </label>
                            <label>Project
                                <select class="ax-input" t-on-change="(ev) => this.save({project_id: Number(ev.target.value)})">
                                    <option value="0" t-att-selected="!ticket.project">None</option>
                                    <option t-foreach="state.data.projects" t-as="p" t-key="p.id" t-att-value="p.id" t-att-selected="ticket.project and ticket.project.id === p.id" t-out="p.name"/>
                                </select>
                            </label>
                            <label>Due date
                                <input class="ax-input" type="datetime-local" t-att-value="ticket.due_input" t-on-change="(ev) => this.save({due_date: ev.target.value})"/>
                            </label>
                            <div class="ax-tagsfield">
                                <span>Tags</span>
                                <div class="ax-taglist">
                                    <span t-foreach="ticket.tags" t-as="tag" t-key="tag.id" class="ax-tag"><t t-out="tag.name"/>
                                        <button type="button" t-att-aria-label="'Remove tag ' + tag.name" t-on-click="() => this.removeTag(tag)"><Icon name="'close'" size="10"/></button>
                                    </span>
                                    <button t-if="!state.tagBox" type="button" class="ax-linkbtn" t-on-click="() => state.tagBox = true">+ Add tag</button>
                                </div>
                                <div t-if="state.tagBox" class="ax-tagadd">
                                    <input class="ax-input" list="ax-taglist" aria-label="New tag" placeholder="Tag name" t-model="state.newTag" t-on-keydown="(ev) => ev.key === 'Enter' and this.addTag()"/>
                                    <datalist id="ax-taglist"><option t-foreach="state.data.all_tags" t-as="tg" t-key="tg.id" t-att-value="tg.name"/></datalist>
                                    <button type="button" class="ax-btn ax-btn-dark ax-btn-sm" t-on-click="addTag">Add</button>
                                </div>
                            </div>
                        </div>
                    </section>
                </t>

                <t t-if="state.rail === 'ai'">
                    <div t-if="!state.summary" class="ax-empty">Analysing the conversation…</div>
                    <div t-else="" class="ax-insights">
                        <p t-out="state.summary.summary"/>
                        <dl>
                            <dt>Tone</dt><dd t-out="state.summary.tone"/>
                            <dt>Deadline mentioned</dt><dd t-out="state.summary.deadline or 'None found'"/>
                            <dt>Provider</dt><dd t-out="state.summary.provider"/>
                        </dl>
                    </div>
                </t>

                <t t-if="state.rail === 'history'">
                    <div t-if="!state.data.history.length" class="ax-empty">No changes yet.</div>
                    <ul class="ax-history">
                        <li t-foreach="state.data.history" t-as="h" t-key="h.id">
                            <strong t-out="h.author"/><small t-out="h.date"/>
                            <div t-foreach="h.changes" t-as="c" t-key="c_index"><t t-out="c.field"/>: <span t-out="c.old or '—'"/> → <strong t-out="c.new or '—'"/></div>
                        </li>
                    </ul>
                </t>

                <t t-if="state.rail === 'tasks'">
                    <div t-if="!ticket.project" class="ax-empty">Link this ticket to a project to see its tasks.</div>
                    <div t-elif="!state.data.tasks.length" class="ax-empty">The project has no tasks.</div>
                    <ul class="ax-tasklist"><li t-foreach="state.data.tasks" t-as="task" t-key="task.id" t-att-class="{'is-done': task.done}"><Icon name="task.done ? 'check' : 'clock'" size="14"/><t t-out="task.name"/></li></ul>
                </t>

                <t t-if="state.rail === 'related'">
                    <div t-if="!state.data.related.length" class="ax-empty">No other tickets from this contact.</div>
                    <a t-foreach="state.data.related" t-as="r" t-key="r.id" t-att-href="'/desk/ticket/' + r.id" class="ax-related"><strong t-out="r.subject"/><small>#<t t-out="r.number"/> · <t t-out="r.state_label"/></small></a>
                </t>

                <t t-if="state.rail === 'macros'">
                    <button type="button" t-foreach="state.data.macros" t-as="m" t-key="m.id" class="ax-macro" t-on-click="() => this.useMacro(m)"><strong t-out="m.name"/><small t-out="m.text"/></button>
                </t>
            </div>
        </aside>

        <!-- ================================================= close dialog -->
        <div t-if="state.closing" class="ax-modal-overlay" t-on-click.self="() => state.closing = false">
            <div class="ax-dialog" role="dialog" aria-modal="true" aria-labelledby="ax-close-title">
                <h2 id="ax-close-title">Close ticket #<t t-out="ticket.number"/></h2>
                <label>Resolution summary
                    <textarea class="ax-input ax-textarea" rows="5" t-model="state.resolution" placeholder="What was done to resolve this?"/>
                </label>
                <label class="ax-check"><input type="checkbox" t-model="state.notify"/>Notify customer and add to knowledge base</label>
                <div class="ax-composer-foot">
                    <span class="ax-spacer"/>
                    <button type="button" class="ax-btn ax-btn-ghost" t-on-click="() => state.closing = false">Cancel</button>
                    <button type="button" class="ax-btn ax-btn-dark" t-on-click="closeTicket">Save resolution</button>
                </div>
            </div>
        </div>
    </div>
</t>

</templates>
