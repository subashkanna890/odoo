<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="aixo_desk.TicketList">
    <div class="ax-layout">
        <aside class="ax-sidebar" aria-label="Ticket views">
            <a href="/desk/analytics" class="ax-side-link"><Icon name="'grid'" size="20"/><span>Dashboard</span></a>
            <div class="ax-side-views-head"><Icon name="'props'" size="20"/><span>Views</span></div>
            <div class="ax-side-section">
                <button type="button" class="ax-side-toggle" t-att-aria-expanded="state.viewsOpen" t-on-click="() => state.viewsOpen = !state.viewsOpen">
                    <span>ALL VIEWS</span><Icon name="state.viewsOpen ? 'chevronDown' : 'chevronRight'" size="14"/>
                </button>
                <t t-if="state.viewsOpen">
                    <button type="button" t-foreach="views" t-as="v" t-key="v[0]" class="ax-view-item" t-att-class="{'is-on': state.view === v[0] and !state.tag}" t-on-click="() => this.setView(v[0])">
                        <span t-out="v[1]"/><span class="ax-view-count" t-out="state.data ? state.data.counts[v[0]] : ''"/>
                    </button>
                </t>
            </div>
            <div class="ax-side-links">
                <button type="button" class="ax-side-link" t-att-class="{'is-on': state.view === 'team'}" t-on-click="() => this.setView('team')">
                    <Icon name="'users'" size="20"/><span>Team Queue</span><span class="ax-view-count" t-out="state.data ? state.data.counts.team : ''"/>
                </button>
                <button type="button" class="ax-side-link" t-att-class="{'is-on': state.view === 'project'}" t-on-click="() => this.setView('project')">
                    <Icon name="'folder'" size="20"/><span>Project Tickets</span><span class="ax-view-count" t-out="state.data ? state.data.counts.project : ''"/>
                </button>
                <button type="button" class="ax-side-link" t-att-aria-expanded="state.tagsOpen" t-on-click="() => state.tagsOpen = !state.tagsOpen">
                    <Icon name="'tag'" size="20"/><span>Tags</span><Icon name="state.tagsOpen ? 'chevronDown' : 'chevronRight'" size="14"/>
                </button>
                <t t-if="state.tagsOpen and state.data">
                    <button type="button" t-foreach="state.data.tags" t-as="tag" t-key="tag.id" class="ax-view-item ax-sub" t-att-class="{'is-on': state.tag === tag.id}" t-on-click="() => this.setTag(tag.id)" t-out="tag.name"/>
                    <p t-if="!state.data.tags.length" class="ax-hint">No tags yet.</p>
                </t>
            </div>
        </aside>

        <main class="ax-main">
            <div class="ax-listbar">
                <button type="button" class="ax-iconbtn" t-att-aria-label="isStarred ? 'Unfavourite this view' : 'Favourite this view'" t-att-aria-pressed="isStarred" t-on-click="toggleStar">
                    <Icon name="'star'" size="20" fill="isStarred ? '#F5B301' : 'none'"/>
                </button>
                <h1 class="ax-listtitle" t-out="title"/>
                <span class="ax-spacer"/>
                <label class="ax-searchbox ax-searchbox-sm"><Icon name="'search'" size="16"/>
                    <input type="search" placeholder="Search tickets" aria-label="Search tickets" t-att-value="state.search" t-on-input="onSearch"/>
                </label>
                <select class="ax-input ax-input-sm" aria-label="Sort tickets" t-on-change="setSort">
                    <option t-foreach="sorts" t-as="s" t-key="s[0]" t-att-value="s[0]" t-att-selected="state.sort === s[0]" t-out="s[1]"/>
                </select>
                <button type="button" class="ax-linkbtn" t-on-click="() => state.showCount = !state.showCount">
                    <t t-out="state.showCount and state.data ? 'Total: ' + state.data.total + ' tickets' : 'Total Count'"/>
                </button>
                <button type="button" class="ax-btn ax-btn-ghost ax-btn-sm" t-att-aria-pressed="state.classic" t-on-click="toggleClassic">
                    <t t-out="state.classic ? 'Card view' : 'Classic View'"/>
                </button>
                <button type="button" class="ax-iconbtn" aria-label="Refresh" t-on-click="load"><Icon name="'refresh'" size="18"/></button>
            </div>

            <div class="ax-listwrap" t-att-aria-busy="state.loading">
                <div t-if="state.data and !state.data.tickets.length and !state.loading" class="ax-empty ax-empty-lg">
                    <strong>No tickets here</strong>
                    <span t-if="state.search">Nothing matches “<t t-out="state.search"/>”.</span>
                    <span t-else="">This view is empty.</span>
                </div>
                <div t-foreach="state.data ? state.data.tickets : []" t-as="t" t-key="t.id" class="ax-ticket-row" t-att-class="{'is-classic': state.classic, 'is-hover': state.hover === t.id}"
                     t-on-mouseenter="() => state.hover = t.id" t-on-mouseleave="() => state.hover = 0">
                    <span class="ax-channel" t-att-title="t.channel"><Icon name="t.channel" size="18"/></span>
                    <div class="ax-ticket-main">
                        <div class="ax-ticket-title">
                            <a t-att-href="'/desk/ticket/' + t.id" t-out="t.subject"/>
                            <a t-att-href="'/desk/ticket/' + t.id + '#reply'" class="ax-iconbtn ax-rowaction" aria-label="Reply"><Icon name="'reply'" size="16"/></a>
                        </div>
                        <div class="ax-ticket-meta">
                            <span>#<t t-out="t.number"/></span><span>·</span>
                            <span t-out="t.contact"/>
                            <t t-if="t.account"><span>·</span><span t-out="t.account"/></t>
                            <span>·</span><span><Icon name="'calendar'" size="12"/> <t t-out="t.created"/></span>
                            <span>·</span><span t-att-class="{'ax-overdue': t.overdue}"><Icon name="'clock'" size="12"/> <t t-out="t.due"/></span>
                        </div>
                    </div>
                    <div class="ax-menu-wrap">
                        <button type="button" t-attf-class="ax-chip {{ statusClass[t.state] }}" aria-haspopup="true" t-on-click="() => this.toggleMenu('status', t.id)">
                            <t t-out="t.state_label"/> <Icon name="'chevronDown'" size="12"/>
                        </button>
                        <div t-if="state.menu === 'status:' + t.id" class="ax-menu" role="menu">
                            <button type="button" role="menuitem" t-foreach="[['open', 'Open'], ['on_hold', 'On Hold'], ['escalated', 'Escalated'], ['closed', 'Closed…']]" t-as="s" t-key="s[0]"
                                    t-att-class="{'is-on': t.state === s[0]}" t-on-click="() => this.changeStatus(t, s[0])" t-out="s[1]"/>
                        </div>
                    </div>
                    <span class="ax-prio" t-att-class="'is-' + t.priority" t-att-title="'Priority: ' + priorityLabel[t.priority]"><Icon name="'flag'" size="14"/> <t t-out="priorityNum[t.priority]"/></span>
                    <span class="ax-replies" title="Replies"><Icon name="'reply'" size="14"/><sup t-out="t.replies"/></span>
                    <div class="ax-menu-wrap ax-owner-cell">
                        <button type="button" t-if="t.owner" class="ax-avatar" t-att-style="'background:' + t.owner.bg + ';color:' + t.owner.fg" t-att-title="t.owner.name + ' — change owner'" t-att-aria-label="'Owner ' + t.owner.name" t-on-click="() => this.toggleMenu('owner', t.id)" t-out="t.owner.initials"/>
                        <button type="button" t-else="" class="ax-avatar ax-avatar-empty" aria-label="Assign agent" t-on-click="() => this.toggleMenu('owner', t.id)"><Icon name="'userPlus'" size="18"/></button>
                        <div t-if="state.menu === 'owner:' + t.id" class="ax-menu ax-menu-right" role="menu">
                            <button type="button" role="menuitem" t-on-click="() => this.assign(t, 0)">Unassigned</button>
                            <button type="button" role="menuitem" t-foreach="state.data.agents" t-as="a" t-key="a.id" t-att-class="{'is-on': t.owner and t.owner.id === a.id}" t-on-click="() => this.assign(t, a.id)" t-out="a.name"/>
                        </div>
                    </div>
                </div>
            </div>

            <div t-if="state.data and state.data.total > state.data.page_size" class="ax-pager">
                <button type="button" class="ax-btn ax-btn-ghost ax-btn-sm" t-att-disabled="state.page &lt;= 1" t-on-click="() => this.go(-1)">Previous</button>
                <span t-out="pageLabel"/>
                <button type="button" class="ax-btn ax-btn-ghost ax-btn-sm" t-att-disabled="state.page &gt;= lastPage" t-on-click="() => this.go(1)">Next</button>
            </div>
        </main>
    </div>
</t>

</templates>
