<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="password_field" name="Aixo password input">
        <div class="ax-field">
            <label t-att-for="field_id" t-out="label"/>
            <div class="ax-pwwrap">
                <input t-att-id="field_id" t-att-name="name" type="password" class="ax-input" t-att-placeholder="placeholder"
                       t-att-autocomplete="autocomplete or 'current-password'" required="required"/>
                <button type="button" class="ax-eye" aria-label="Show password" data-ax-toggle-pw="">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>
                </button>
            </div>
        </div>
    </template>

    <!-- ================================================================ LOGIN -->
    <template id="login_page" name="Aixo Desk login">
        <t t-call="aixo_desk.auth_layout">
            <section class="ax-hero" aria-label="Welcome">
                <h1 class="ax-h1" data-ax-typed="Welcome back to your helpdesk." data-ax-accent="your helpdesk">
                    Welcome back to <span class="ax-accent">your helpdesk.</span>
                </h1>
                <p class="ax-lead ax-rise"><span class="ax-ink">Your desk is ready.</span> Pick up open tickets, client projects and customer history right where your team left off.</p>
                <div class="ax-rise ax-tips" data-ax-tips="">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#3E8A16" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"/></svg>
                    <span class="ax-tip" data-ax-tip="">Aixo routes new tickets to the right agent for you.</span>
                    <span hidden="hidden" data-ax-tip-item="">Tip: press S anywhere to open Setup.</span>
                    <span hidden="hidden" data-ax-tip-item="">Customer health scores sit on every contact.</span>
                </div>
            </section>

            <section class="ax-card ax-rise" aria-label="Log in">
                <div class="ax-card-head">
                    <h2>Log in</h2>
                    <p>Choose your portal to continue</p>
                </div>
                <div t-if="reset_done" class="ax-alert ax-alert-ok" role="status">Password updated. Log in with your new password.</div>
                <div t-if="error" class="ax-alert ax-alert-err" role="alert" t-out="error"/>
                <form action="/desk/login" method="post" class="ax-form" data-ax-login="">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input type="hidden" name="redirect" t-att-value="redirect"/>
                    <div class="ax-seg" role="radiogroup" aria-label="Sign in as">
                        <t t-foreach="[('admin','Admin','M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z'),('employee','Employee','M4 7h16v13H4zM9 7V4h6v3'),('customer','Customer','M12 3a4 4 0 1 1 0 8 4 4 0 0 1 0-8zM4 21a8 8 0 0 1 16 0')]" t-as="p">
                            <input type="radio" name="portal" t-att-id="'portal-' + p[0]" t-att-value="p[0]" t-att-checked="'checked' if portal == p[0] else None" t-att-data-label="p[1]"/>
                            <label t-att-for="'portal-' + p[0]">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path t-att-d="p[2]"/></svg>
                                <t t-out="p[1]"/>
                            </label>
                        </t>
                    </div>
                    <div class="ax-field">
                        <label for="login-email">Email</label>
                        <input id="login-email" name="login" type="email" class="ax-input" placeholder="you@company.com"
                               autocomplete="username" required="required" t-att-value="login"/>
                    </div>
                    <div class="ax-field">
                        <div class="ax-label-row">
                            <label for="login-password">Password</label>
                            <a href="/desk/reset" class="ax-link-small">Forgot password?</a>
                        </div>
                        <div class="ax-pwwrap">
                            <input id="login-password" name="password" type="password" class="ax-input" placeholder="Enter your password"
                                   autocomplete="current-password" required="required"/>
                            <button type="button" class="ax-eye" aria-label="Show password" data-ax-toggle-pw="">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>
                            </button>
                        </div>
                    </div>
                    <label class="ax-check"><input type="checkbox" name="keep" value="1"/>Keep me logged in</label>
                    <button type="submit" class="ax-btn ax-btn-dark ax-btn-lg ax-pill" data-ax-submit="">
                        <span data-ax-submit-label="">Log in as Employee</span><span class="ax-dot"/>
                    </button>
                </form>
                <p t-if="signup_enabled" class="ax-foot">New to Aixo Desk? <a href="/desk/signup" class="ax-link">Create an account</a></p>
            </section>
        </t>
    </template>

    <!-- ================================================================ SIGNUP -->
    <template id="signup_disabled_page" name="Aixo Desk sign-up disabled">
        <t t-call="aixo_desk.auth_layout">
            <section class="ax-card ax-card-solo">
                <h2>Sign-up is closed</h2>
                <p>Public sign-up is turned off. Ask your administrator to create your account.</p>
                <a href="/desk/login" class="ax-btn ax-btn-dark ax-pill">Go to log in</a>
            </section>
        </t>
    </template>

    <template id="signup_page" name="Aixo Desk sign-up">
        <t t-call="aixo_desk.auth_layout">
            <section class="ax-hero" aria-label="Welcome">
                <h1 class="ax-h1" data-ax-typed="Start your helpdesk in minutes." data-ax-accent="in minutes">
                    Start your helpdesk <span class="ax-accent">in minutes.</span>
                </h1>
                <ul class="ax-perks">
                    <li class="ax-rise">Tickets, projects and customers in one desk</li>
                    <li class="ax-rise">Separate admin, employee and customer portals</li>
                    <li class="ax-rise">AI routing and SLA timers from day one</li>
                </ul>
            </section>

            <section class="ax-card ax-rise" aria-label="Create your account">
                <t t-if="done">
                    <div class="ax-done" role="status">
                        <div class="ax-done-icon" aria-hidden="true">
                            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5 9-10"/></svg>
                        </div>
                        <h2>Welcome aboard, <t t-out="first"/></h2>
                        <p>Your account is ready. We've sent a confirmation to your email.</p>
                        <a href="/desk/login?portal=customer" class="ax-btn ax-btn-dark ax-btn-lg ax-pill">Go to log in<span class="ax-dot"/></a>
                    </div>
                </t>
                <t t-else="">
                    <div class="ax-card-head">
                        <h2>Create your account</h2>
                        <p>It takes less than a minute</p>
                    </div>
                    <div t-if="error" class="ax-alert ax-alert-err" role="alert" t-out="error"/>
                    <form action="/desk/signup" method="post" class="ax-form" data-ax-signup="" novalidate="novalidate">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <div class="ax-row2">
                            <div class="ax-field">
                                <label for="su-first">First name</label>
                                <input id="su-first" name="first" class="ax-input" autocomplete="given-name" required="required" t-att-value="form.get('first')"/>
                            </div>
                            <div class="ax-field">
                                <label for="su-last">Last name</label>
                                <input id="su-last" name="last" class="ax-input" autocomplete="family-name" t-att-value="form.get('last')"/>
                            </div>
                        </div>
                        <div class="ax-field">
                            <label for="su-email">Work email</label>
                            <input id="su-email" name="email" type="email" class="ax-input" placeholder="you@company.com" autocomplete="email" required="required" t-att-value="form.get('email')"/>
                        </div>
                        <div class="ax-field">
                            <label for="su-company">Company</label>
                            <input id="su-company" name="company" class="ax-input" autocomplete="organization" t-att-value="form.get('company')"/>
                        </div>
                        <t t-call="aixo_desk.password_field">
                            <t t-set="field_id" t-value="'su-password'"/>
                            <t t-set="name" t-value="'password'"/>
                            <t t-set="label" t-value="'Password'"/>
                            <t t-set="placeholder" t-value="'At least 8 characters'"/>
                            <t t-set="autocomplete" t-value="'new-password'"/>
                        </t>
                        <div class="ax-strength" aria-hidden="true" data-ax-strength=""><span/><span/><span/><span/></div>
                        <label class="ax-check"><input type="checkbox" name="terms" value="1"/>I agree to the Terms and Privacy Policy</label>
                        <button type="submit" class="ax-btn ax-btn-dark ax-btn-lg ax-pill">Create account<span class="ax-dot"/></button>
                    </form>
                    <p class="ax-foot">Already have an account? <a href="/desk/login" class="ax-link">Log in</a></p>
                </t>
            </section>
        </t>
    </template>

    <!-- ============================================================== RESET -->
    <template id="reset_page" name="Aixo Desk password reset">
        <t t-call="aixo_desk.auth_layout">
            <section class="ax-hero" aria-label="Reset your password">
                <h1 class="ax-h1" data-ax-typed="Locked out? Let's get you back in." data-ax-accent="Let's">
                    Locked out? <span class="ax-accent">Let's get you back in.</span>
                </h1>
                <ol class="ax-steps" data-ax-steps="">
                    <li data-ax-step="1" class="is-current"><span class="ax-step-dot">1</span><span><strong>Enter your email</strong><small>We find your account</small></span></li>
                    <li data-ax-step="2"><span class="ax-step-dot">2</span><span><strong>Verify the code</strong><small>6-digit code from your inbox</small></span></li>
                    <li data-ax-step="3"><span class="ax-step-dot">3</span><span><strong>Set a new password</strong><small>Then log in again</small></span></li>
                </ol>
            </section>

            <section class="ax-card ax-rise" aria-label="Password reset" data-ax-reset="">
                <div class="ax-alert ax-alert-err" role="alert" hidden="hidden" data-ax-error=""/>
                <noscript><div class="ax-alert ax-alert-err">JavaScript is required to reset your password.</div></noscript>

                <div data-ax-panel="1">
                    <div class="ax-card-head"><h2>Forgot your password?</h2><p>Enter your email and we'll send a 6-digit code.</p></div>
                    <form class="ax-form" data-ax-form="send" novalidate="novalidate">
                        <div class="ax-field">
                            <label for="rs-email">Email</label>
                            <input id="rs-email" name="email" type="email" class="ax-input" placeholder="you@company.com" autocomplete="username" required="required"/>
                        </div>
                        <button type="submit" class="ax-btn ax-btn-dark ax-btn-lg ax-pill">Send code<span class="ax-dot"/></button>
                    </form>
                </div>

                <div data-ax-panel="2" hidden="hidden">
                    <div class="ax-card-head"><h2>Check your email</h2><p>We sent a code to <strong data-ax-email-label=""/>. <button type="button" class="ax-linkbtn" data-ax-change="">Change</button></p></div>
                    <form class="ax-form" data-ax-form="verify" novalidate="novalidate">
                        <div class="ax-otp" role="group" aria-label="6-digit code">
                            <t t-foreach="range(1, 7)" t-as="n">
                                <input class="ax-otp-box" type="text" inputmode="numeric" maxlength="1" autocomplete="one-time-code"
                                       t-att-aria-label="'Digit %s' % n" data-ax-otp=""/>
                            </t>
                        </div>
                        <button type="submit" class="ax-btn ax-btn-dark ax-btn-lg ax-pill">Verify code<span class="ax-dot"/></button>
                        <p class="ax-foot"><span data-ax-waiting="">Resend code in <strong data-ax-timer="">30</strong>s</span>
                            <button type="button" class="ax-linkbtn" data-ax-resend="" hidden="hidden">Resend code</button></p>
                    </form>
                </div>

                <div data-ax-panel="3" hidden="hidden">
                    <div class="ax-card-head"><h2>Set a new password</h2><p>Use at least 8 characters.</p></div>
                    <form class="ax-form" data-ax-form="reset" novalidate="novalidate">
                        <t t-call="aixo_desk.password_field">
                            <t t-set="field_id" t-value="'rs-pw1'"/>
                            <t t-set="name" t-value="'password'"/>
                            <t t-set="label" t-value="'New password'"/>
                            <t t-set="placeholder" t-value="'New password'"/>
                            <t t-set="autocomplete" t-value="'new-password'"/>
                        </t>
                        <div class="ax-strength" aria-hidden="true" data-ax-strength=""><span/><span/><span/><span/></div>
                        <t t-call="aixo_desk.password_field">
                            <t t-set="field_id" t-value="'rs-pw2'"/>
                            <t t-set="name" t-value="'confirm'"/>
                            <t t-set="label" t-value="'Confirm password'"/>
                            <t t-set="placeholder" t-value="'Repeat the password'"/>
                            <t t-set="autocomplete" t-value="'new-password'"/>
                        </t>
                        <p class="ax-hint ax-hint-err" hidden="hidden" data-ax-mismatch="">Passwords do not match.</p>
                        <button type="submit" class="ax-btn ax-btn-dark ax-btn-lg ax-pill" disabled="disabled" data-ax-reset-btn="">Reset password<span class="ax-dot"/></button>
                    </form>
                </div>

                <div data-ax-panel="4" hidden="hidden" class="ax-done" role="status">
                    <div class="ax-done-icon" aria-hidden="true"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5 9-10"/></svg></div>
                    <h2>Password updated</h2>
                    <p>You've been signed out everywhere else. Log in with your new password.</p>
                    <a href="/desk/login?reset=1" class="ax-btn ax-btn-dark ax-btn-lg ax-pill">Back to log in<span class="ax-dot"/></a>
                </div>
            </section>
        </t>
    </template>

    <!-- ===================================================== FORCED PW CHANGE -->
    <template id="password_change_page" name="Aixo Desk change password">
        <t t-call="aixo_desk.auth_layout">
            <section class="ax-card ax-card-solo" aria-label="Change password">
                <div class="ax-card-head">
                    <h2>Set a new password</h2>
                    <p t-if="forced">An administrator asked you to choose a new password before continuing.</p>
                </div>
                <div t-if="error" class="ax-alert ax-alert-err" role="alert" t-out="error"/>
                <form action="/desk/password/change" method="post" class="ax-form">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <t t-call="aixo_desk.password_field">
                        <t t-set="field_id" t-value="'pc-pw1'"/><t t-set="name" t-value="'password'"/>
                        <t t-set="label" t-value="'New password'"/><t t-set="placeholder" t-value="'At least 8 characters'"/>
                        <t t-set="autocomplete" t-value="'new-password'"/>
                    </t>
                    <t t-call="aixo_desk.password_field">
                        <t t-set="field_id" t-value="'pc-pw2'"/><t t-set="name" t-value="'confirm'"/>
                        <t t-set="label" t-value="'Confirm password'"/><t t-set="placeholder" t-value="'Repeat the password'"/>
                        <t t-set="autocomplete" t-value="'new-password'"/>
                    </t>
                    <button type="submit" class="ax-btn ax-btn-dark ax-btn-lg ax-pill">Save password<span class="ax-dot"/></button>
                </form>
            </section>
        </t>
    </template>

    <!-- ===================================================================== MAIL -->
    <template id="mail_otp" name="Aixo Desk OTP mail">
        <div style="font-family:Arial,sans-serif;max-width:480px;margin:0 auto;color:#0F2A20">
            <p>Hi <t t-out="name"/>,</p>
            <p>Use this code to reset your <t t-out="company_name"/> password. It expires in 10 minutes.</p>
            <p style="font-size:32px;letter-spacing:8px;font-weight:600;color:#0E3B2F"><t t-out="code"/></p>
            <p style="color:#62756B;font-size:13px">If you didn't ask for this, you can ignore this email.</p>
        </div>
    </template>
    <template id="mail_welcome" name="Aixo Desk welcome mail">
        <div style="font-family:Arial,sans-serif;max-width:480px;margin:0 auto;color:#0F2A20">
            <p>Welcome aboard, <t t-out="first"/>!</p>
            <p>Your <t t-out="company_name"/> account is ready. You can raise tickets and follow their progress from your customer portal.</p>
            <p><a t-att-href="login_url" style="background:#0E3B2F;color:#fff;padding:10px 20px;border-radius:20px;text-decoration:none">Log in</a></p>
        </div>
    </template>
    <template id="mail_assign" name="Aixo Desk assignment mail">
        <div style="font-family:Arial,sans-serif;max-width:520px;color:#0F2A20">
            <p>Hi <t t-out="name"/>,</p>
            <p><t t-out="count"/> ticket(s) were assigned to you in <t t-out="company_name"/>:</p>
            <ul><li t-foreach="tickets" t-as="t"><t t-out="'#' + t[0]"/> <t t-out="t[1]"/></li></ul>
            <p><a t-att-href="url" style="background:#0E3B2F;color:#fff;padding:10px 20px;border-radius:20px;text-decoration:none">Open your tickets</a></p>
        </div>
    </template>
    <template id="mail_login" name="Aixo Desk login details mail">
        <div style="font-family:Arial,sans-serif;max-width:520px;color:#0F2A20">
            <p>Hi <t t-out="name"/>,</p>
            <p>An account was created for you on <t t-out="company_name"/>.</p>
            <p>Login: <strong t-out="login"/><br/>
               <t t-if="password">Temporary password: <strong t-out="password"/></t>
               <t t-else="">Use “Forgot password?” on the login page to choose your password.</t></p>
            <p t-if="force">You will be asked to choose a new password the first time you log in.</p>
            <p><a t-att-href="login_url" style="background:#0E3B2F;color:#fff;padding:10px 20px;border-radius:20px;text-decoration:none">Log in</a></p>
        </div>
    </template>
    <template id="mail_csat" name="Aixo Desk satisfaction survey mail">
        <div style="font-family:Arial,sans-serif;max-width:520px;color:#0F2A20">
            <p>Hi <t t-out="name"/>,</p>
            <p>Your request <strong>#<t t-out="number"/> <t t-out="subject"/></strong> was resolved. How did we do?</p>
            <p>
                <t t-foreach="links" t-as="link">
                    <a t-att-href="link[1]" style="display:inline-block;margin-right:8px;background:#0E3B2F;color:#fff;padding:10px 20px;border-radius:20px;text-decoration:none" t-out="link[0]"/>
                </t>
            </p>
            <p style="color:#62756B;font-size:13px">One click is all it takes. Thank you for helping us improve <t t-out="company_name"/>.</p>
        </div>
    </template>
    <template id="csat_page" name="Aixo Desk satisfaction page">
        <t t-call="aixo_desk.auth_layout">
            <section class="ax-hero">
                <h1 class="ax-h1">Thanks for the feedback<span class="ax-accent">.</span></h1>
                <p class="ax-lead">It helps us improve how we support you.</p>
            </section>
            <section class="ax-card ax-rise" aria-label="Rate your request">
                <t t-if="status == 'open'">
                    <h2>Ticket #<t t-out="ticket.number"/></h2>
                    <p>This request is still open, so it cannot be rated yet.</p>
                </t>
                <t t-else="">
                    <div class="ax-card-head">
                        <h2>Ticket #<t t-out="ticket.number"/></h2>
                        <p><t t-out="ticket.name"/></p>
                    </div>
                    <div class="ax-alert ax-alert-ok" role="status">
                        <t t-if="status == 'already'">You already rated this request <strong t-out="labels[score]"/>. You can change it below.</t>
                        <t t-else="">Your rating: <strong t-out="labels[score]"/>.</t>
                    </div>
                    <form t-attf-action="/desk/csat/#{token}" method="post" class="ax-form">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <div class="ax-seg" role="radiogroup" aria-label="Rating">
                            <t t-foreach="['good', 'okay', 'bad']" t-as="s">
                                <input type="radio" name="score" t-att-id="'cs-' + s" t-att-value="s" t-att-checked="'checked' if score == s else None"/>
                                <label t-att-for="'cs-' + s" t-out="labels[s]"/>
                            </t>
                        </div>
                        <div class="ax-field"><label for="cs-comment">Anything to add? (optional)</label>
                            <textarea id="cs-comment" name="comment" class="ax-input ax-textarea" rows="3"><t t-out="ticket.rating_comment or ''"/></textarea></div>
                        <button type="submit" class="ax-btn ax-btn-dark ax-btn-lg ax-pill">Save feedback<span class="ax-dot"/></button>
                    </form>
                </t>
            </section>
        </t>
    </template>
</odoo>
