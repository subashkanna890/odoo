<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Teams -->
    <record id="aixo_team_view_list" model="ir.ui.view">
        <field name="name">aixo.team.list</field>
        <field name="model">aixo.team</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="department"/>
                <field name="lead_id"/>
                <field name="member_ids" widget="many2many_tags"/>
                <field name="open_ticket_count"/>
            </list>
        </field>
    </record>
    <record id="aixo_team_view_form" model="ir.ui.view">
        <field name="name">aixo.team.form</field>
        <field name="model">aixo.team</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="department"/>
                            <field name="description"/>
                            <field name="email"/>
                        </group>
                        <group>
                            <field name="lead_id"/>
                            <field name="member_ids" widget="many2many_avatar_user"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="aixo_team_action" model="ir.actions.act_window">
        <field name="name">Teams</field>
        <field name="res_model">aixo.team</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Business hours and holidays -->
    <record id="aixo_business_hours_view_form" model="ir.ui.view">
        <field name="name">aixo.business.hours.form</field>
        <field name="model">aixo.business.hours</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="tz"/>
                        <field name="is_default"/>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="weekday"/>
                            <field name="hour_from" widget="float_time"/>
                            <field name="hour_to" widget="float_time"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="aixo_business_hours_view_list" model="ir.ui.view">
        <field name="name">aixo.business.hours.list</field>
        <field name="model">aixo.business.hours</field>
        <field name="arch" type="xml">
            <list><field name="name"/><field name="tz"/><field name="is_default"/></list>
        </field>
    </record>
    <record id="aixo_business_hours_action" model="ir.actions.act_window">
        <field name="name">Business hours</field>
        <field name="res_model">aixo.business.hours</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="aixo_holiday_view_list" model="ir.ui.view">
        <field name="name">aixo.holiday.list</field>
        <field name="model">aixo.holiday</field>
        <field name="arch" type="xml">
            <list editable="bottom"><field name="name"/><field name="date"/><field name="team_id"/></list>
        </field>
    </record>
    <record id="aixo_holiday_action" model="ir.actions.act_window">
        <field name="name">Holidays</field>
        <field name="res_model">aixo.holiday</field>
        <field name="view_mode">list</field>
    </record>

    <!-- SLA -->
    <record id="aixo_sla_view_form" model="ir.ui.view">
        <field name="name">aixo.sla.policy.form</field>
        <field name="model">aixo.sla.policy</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="business_hours_id"/>
                        <field name="plan"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="priority"/>
                            <field name="first_response_hours"/>
                            <field name="resolution_hours"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="aixo_sla_view_list" model="ir.ui.view">
        <field name="name">aixo.sla.policy.list</field>
        <field name="model">aixo.sla.policy</field>
        <field name="arch" type="xml">
            <list><field name="sequence" widget="handle"/><field name="name"/><field name="plan"/><field name="business_hours_id"/></list>
        </field>
    </record>
    <record id="aixo_sla_action" model="ir.actions.act_window">
        <field name="name">SLA policies</field>
        <field name="res_model">aixo.sla.policy</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Assignment rules -->
    <record id="aixo_assignment_rule_view_list" model="ir.ui.view">
        <field name="name">aixo.assignment.rule.list</field>
        <field name="model">aixo.assignment.rule</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="team_id"/>
                <field name="mode"/>
                <field name="match_skills"/>
            </list>
        </field>
    </record>
    <record id="aixo_assignment_rule_action" model="ir.actions.act_window">
        <field name="name">Assignment rules</field>
        <field name="res_model">aixo.assignment.rule</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Macros -->
    <record id="aixo_macro_view_list" model="ir.ui.view">
        <field name="name">aixo.macro.list</field>
        <field name="model">aixo.macro</field>
        <field name="arch" type="xml">
            <list><field name="sequence" widget="handle"/><field name="name"/><field name="suggest"/><field name="set_state"/><field name="usage_count"/></list>
        </field>
    </record>
    <record id="aixo_macro_view_form" model="ir.ui.view">
        <field name="name">aixo.macro.form</field>
        <field name="model">aixo.macro</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="body"/>
                        <field name="suggest"/>
                        <field name="set_state"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="aixo_macro_action" model="ir.actions.act_window">
        <field name="name">Macros</field>
        <field name="res_model">aixo.macro</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Ticket templates -->
    <record id="aixo_template_view_list" model="ir.ui.view">
        <field name="name">aixo.ticket.template.list</field>
        <field name="model">aixo.ticket.template</field>
        <field name="arch" type="xml">
            <list><field name="name"/><field name="priority"/><field name="classification"/><field name="team_id"/></list>
        </field>
    </record>
    <record id="aixo_template_view_form" model="ir.ui.view">
        <field name="name">aixo.ticket.template.form</field>
        <field name="model">aixo.ticket.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="subject_prefix"/>
                        <field name="priority"/>
                        <field name="classification"/>
                        <field name="team_id"/>
                        <field name="active"/>
                    </group>
                    <field name="description"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="aixo_template_action" model="ir.actions.act_window">
        <field name="name">Ticket templates</field>
        <field name="res_model">aixo.ticket.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Small lookup models: editable lists -->
    <record id="aixo_tag_action" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">aixo.ticket.tag</field>
        <field name="view_mode">list</field>
    </record>
    <record id="aixo_tag_view_list" model="ir.ui.view">
        <field name="name">aixo.ticket.tag.list</field>
        <field name="model">aixo.ticket.tag</field>
        <field name="arch" type="xml"><list editable="bottom"><field name="name"/></list></field>
    </record>
    <record id="aixo_product_action" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">aixo.product</field>
        <field name="view_mode">list</field>
    </record>
    <record id="aixo_product_view_list" model="ir.ui.view">
        <field name="name">aixo.product.list</field>
        <field name="model">aixo.product</field>
        <field name="arch" type="xml"><list editable="bottom"><field name="name"/><field name="team_id"/><field name="ticket_count"/></list></field>
    </record>
    <record id="aixo_skill_action" model="ir.actions.act_window">
        <field name="name">Skills</field>
        <field name="res_model">aixo.skill</field>
        <field name="view_mode">list</field>
    </record>
    <record id="aixo_skill_view_list" model="ir.ui.view">
        <field name="name">aixo.skill.list</field>
        <field name="model">aixo.skill</field>
        <field name="arch" type="xml"><list editable="bottom"><field name="name"/></list></field>
    </record>

    <!-- Support / debugging -->
    <record id="aixo_otp_view_list" model="ir.ui.view">
        <field name="name">aixo.otp.list</field>
        <field name="model">aixo.otp</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="user_id"/>
                <field name="create_date"/>
                <field name="expires_at"/>
                <field name="attempts"/>
                <field name="used"/>
                <field name="verified"/>
            </list>
        </field>
    </record>
    <record id="aixo_otp_action" model="ir.actions.act_window">
        <field name="name">Reset codes (log)</field>
        <field name="res_model">aixo.otp</field>
        <field name="view_mode">list</field>
    </record>

    <record id="aixo_demo_request_view_list" model="ir.ui.view">
        <field name="name">aixo.demo.request.list</field>
        <field name="model">aixo.demo.request</field>
        <field name="arch" type="xml">
            <list><field name="create_date"/><field name="name"/><field name="email"/><field name="company"/><field name="team_size"/><field name="lead_ref"/></list>
        </field>
    </record>
    <record id="aixo_demo_request_view_form" model="ir.ui.view">
        <field name="name">aixo.demo.request.form</field>
        <field name="model">aixo.demo.request</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/><field name="email"/><field name="company"/>
                        <field name="team_size"/><field name="message"/><field name="lead_ref"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="aixo_demo_request_action" model="ir.actions.act_window">
        <field name="name">Demo requests</field>
        <field name="res_model">aixo.demo.request</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
