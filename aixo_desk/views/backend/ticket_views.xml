<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="aixo_ticket_view_list" model="ir.ui.view">
        <field name="name">aixo.ticket.list</field>
        <field name="model">aixo.ticket</field>
        <field name="arch" type="xml">
            <list string="Tickets" decoration-danger="is_overdue" decoration-muted="state == 'closed'">
                <field name="number"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="account_id" optional="show"/>
                <field name="owner_id" widget="many2one_avatar_user"/>
                <field name="team_id" optional="hide"/>
                <field name="priority"/>
                <field name="channel" optional="hide"/>
                <field name="due_date"/>
                <field name="sla_status" widget="badge" optional="show"/>
                <field name="state" widget="badge"
                       decoration-danger="state == 'open'" decoration-warning="state == 'on_hold'"
                       decoration-info="state == 'escalated'" decoration-success="state == 'closed'"/>
                <field name="is_overdue" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="aixo_ticket_view_form" model="ir.ui.view">
        <field name="name">aixo.ticket.form</field>
        <field name="model">aixo.ticket</field>
        <field name="arch" type="xml">
            <form string="Ticket">
                <header>
                    <button name="action_reopen" type="object" string="Reopen" invisible="state != 'closed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,on_hold,escalated,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="number" class="me-2"/><field name="name" placeholder="Subject"/></h1>
                    </div>
                    <group>
                        <group string="Ticket information">
                            <field name="partner_id"/>
                            <field name="account_id"/>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="owner_id"/>
                            <field name="team_id"/>
                            <field name="product_id"/>
                            <field name="project_id"/>
                        </group>
                        <group string="Additional information">
                            <field name="priority"/>
                            <field name="channel"/>
                            <field name="classification"/>
                            <field name="lang_id"/>
                            <field name="due_date"/>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            <field name="template_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description"/>
                        </page>
                        <page string="Resolution" name="resolution">
                            <group>
                                <field name="resolution_summary"/>
                                <field name="notify_resolution"/>
                                <field name="closed_on"/>
                                <field name="rating"/>
                                <field name="rating_comment"/>
                            </group>
                        </page>
                        <page string="SLA" name="sla">
                            <group>
                                <field name="sla_policy_id"/>
                                <field name="first_response_deadline"/>
                                <field name="responded_on"/>
                                <field name="resolution_deadline"/>
                                <field name="sla_status"/>
                                <field name="is_overdue"/>
                                <field name="hold_since"/>
                            </group>
                        </page>
                        <page string="Time entries" name="time">
                            <field name="time_entry_ids">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="user_id"/>
                                    <field name="name"/>
                                    <field name="duration" widget="float_time"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="hours_logged" widget="float_time"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="aixo_ticket_view_kanban" model="ir.ui.view">
        <field name="name">aixo.ticket.kanban</field>
        <field name="model">aixo.ticket</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" records_draggable="1">
                <field name="priority"/>
                <field name="is_overdue"/>
                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-bold"/>
                        <div class="text-muted">#<field name="number"/> · <field name="partner_id"/></div>
                        <div class="d-flex justify-content-between mt-2">
                            <field name="due_date" widget="remaining_days" invisible="state == 'closed'"/>
                            <field name="owner_id" widget="many2one_avatar_user"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="aixo_ticket_view_search" model="ir.ui.view">
        <field name="name">aixo.ticket.search</field>
        <field name="model">aixo.ticket</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Ticket" filter_domain="['|', ('name', 'ilike', self), ('number', 'ilike', self)]"/>
                <field name="partner_id"/>
                <field name="owner_id"/>
                <field name="team_id"/>
                <filter name="my_open" string="My open tickets" domain="[('owner_id', '=', uid), ('state', '!=', 'closed')]"/>
                <filter name="unassigned" string="Unassigned" domain="[('owner_id', '=', False), ('state', '!=', 'closed')]"/>
                <filter name="overdue" string="Overdue" domain="[('is_overdue', '=', True)]"/>
                <filter name="closed" string="Closed" domain="[('state', '=', 'closed')]"/>
                <separator/>
                <filter name="high" string="High / Urgent" domain="[('priority', 'in', ('high', 'urgent'))]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_owner" string="Owner" context="{'group_by': 'owner_id'}"/>
                    <filter name="group_team" string="Team" context="{'group_by': 'team_id'}"/>
                    <filter name="group_priority" string="Priority" context="{'group_by': 'priority'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="aixo_ticket_action" model="ir.actions.act_window">
        <field name="name">Tickets</field>
        <field name="res_model">aixo.ticket</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="aixo_ticket_view_search"/>
        <field name="context">{'search_default_my_open': 0}</field>
    </record>

    <record id="aixo_time_entry_view_list" model="ir.ui.view">
        <field name="name">aixo.time.entry.list</field>
        <field name="model">aixo.time.entry</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="date"/>
                <field name="ticket_id"/>
                <field name="user_id"/>
                <field name="name"/>
                <field name="duration" widget="float_time" sum="Total"/>
            </list>
        </field>
    </record>
    <record id="aixo_time_entry_action" model="ir.actions.act_window">
        <field name="name">Time entries</field>
        <field name="res_model">aixo.time.entry</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
