<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="template_bug" model="aixo.ticket.template">
        <field name="name">Bug report</field>
        <field name="subject_prefix">Bug: </field>
        <field name="description"><![CDATA[<p>Steps to reproduce:</p><ol><li><br></li><li><br></li></ol><p>Expected result:</p><p>Actual result:</p>]]></field>
        <field name="priority">high</field>
        <field name="classification">problem</field>
    </record>
    <record id="template_module" model="aixo.ticket.template">
        <field name="name">New module request</field>
        <field name="subject_prefix">New module request: </field>
        <field name="description"><![CDATA[<p>Describe the module, the users and the main features needed.</p>]]></field>
        <field name="priority">medium</field>
        <field name="classification">feature</field>
    </record>
    <record id="template_billing" model="aixo.ticket.template">
        <field name="name">Billing query</field>
        <field name="subject_prefix">Billing: </field>
        <field name="description"><![CDATA[<p>Invoice number:</p><p>Question:</p>]]></field>
        <field name="priority">low</field>
        <field name="classification">question</field>
    </record>
</odoo>
