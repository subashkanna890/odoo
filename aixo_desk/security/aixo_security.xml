<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_aixo_desk" model="res.groups.privilege">
        <field name="name">Aixo Desk</field>
        <field name="sequence">40</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>

    <record id="group_desk_agent" model="res.groups">
        <field name="name">Employee (agent)</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_aixo_desk"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Works the tickets assigned to them, their projects and linked customers.</field>
    </record>

    <record id="group_desk_admin" model="res.groups">
        <field name="name">Admin</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_aixo_desk"/>
        <field name="implied_ids" eval="[(4, ref('group_desk_agent'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Sees everything, plus employees, assignment, reports and setup.</field>
    </record>

    <record id="group_desk_customer" model="res.groups">
        <field name="name">Customer</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_aixo_desk"/>
        <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
        <field name="comment">Portal user who sees only their own tickets.</field>
    </record>

    <data noupdate="1">
        <!-- Tickets -->
        <record id="rule_ticket_customer" model="ir.rule">
            <field name="name">Aixo ticket: customer sees own (and company if shared)</field>
            <field name="model_id" ref="model_aixo_ticket"/>
            <field name="groups" eval="[(4, ref('group_desk_customer'))]"/>
            <field name="domain_force">['|', ('partner_id', '=', user.partner_id.id), '&amp;', ('partner_id.commercial_partner_id', '=', user.partner_id.commercial_partner_id.id), (user.desk_share_company and 1 or 0, '=', 1)]</field>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="rule_ticket_agent" model="ir.rule">
            <field name="name">Aixo ticket: agent sees assigned (and team queue if enabled)</field>
            <field name="model_id" ref="model_aixo_ticket"/>
            <field name="groups" eval="[(4, ref('group_desk_agent'))]"/>
            <field name="domain_force">['|', ('owner_id', '=', user.id), '&amp;', '&amp;', (user.desk_team_queue and 1 or 0, '=', 1), ('owner_id', '=', False), ('team_id', 'in', user.desk_team_ids.ids)]</field>
        </record>
        <record id="rule_ticket_admin" model="ir.rule">
            <field name="name">Aixo ticket: admin sees all</field>
            <field name="model_id" ref="model_aixo_ticket"/>
            <field name="groups" eval="[(4, ref('group_desk_admin'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- Time entries -->
        <record id="rule_time_agent" model="ir.rule">
            <field name="name">Aixo time entry: own entries</field>
            <field name="model_id" ref="model_aixo_time_entry"/>
            <field name="groups" eval="[(4, ref('group_desk_agent'))]"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
        </record>
        <record id="rule_time_admin" model="ir.rule">
            <field name="name">Aixo time entry: admin all</field>
            <field name="model_id" ref="model_aixo_time_entry"/>
            <field name="groups" eval="[(4, ref('group_desk_admin'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- Projects -->
        <record id="rule_project_customer" model="ir.rule">
            <field name="name">Aixo project: customer sees own</field>
            <field name="model_id" ref="model_aixo_project"/>
            <field name="groups" eval="[(4, ref('group_desk_customer'))]"/>
            <field name="domain_force">[('partner_id.commercial_partner_id', '=', user.partner_id.commercial_partner_id.id)]</field>
        </record>
        <record id="rule_project_agent" model="ir.rule">
            <field name="name">Aixo project: agent sees projects they are member of</field>
            <field name="model_id" ref="model_aixo_project"/>
            <field name="groups" eval="[(4, ref('group_desk_agent'))]"/>
            <field name="domain_force">[('member_ids', 'in', user.id)]</field>
        </record>
        <record id="rule_project_admin" model="ir.rule">
            <field name="name">Aixo project: admin all</field>
            <field name="model_id" ref="model_aixo_project"/>
            <field name="groups" eval="[(4, ref('group_desk_admin'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
        <record id="rule_task_customer" model="ir.rule">
            <field name="name">Aixo task: customer sees own project tasks</field>
            <field name="model_id" ref="model_aixo_project_task"/>
            <field name="groups" eval="[(4, ref('group_desk_customer'))]"/>
            <field name="domain_force">[('project_id.partner_id.commercial_partner_id', '=', user.partner_id.commercial_partner_id.id)]</field>
        </record>
        <record id="rule_task_agent" model="ir.rule">
            <field name="name">Aixo task: agent sees tasks of their projects</field>
            <field name="model_id" ref="model_aixo_project_task"/>
            <field name="groups" eval="[(4, ref('group_desk_agent'))]"/>
            <field name="domain_force">[('project_id.member_ids', 'in', user.id)]</field>
        </record>
        <record id="rule_task_admin" model="ir.rule">
            <field name="name">Aixo task: admin all</field>
            <field name="model_id" ref="model_aixo_project_task"/>
            <field name="groups" eval="[(4, ref('group_desk_admin'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
        <record id="rule_milestone_customer" model="ir.rule">
            <field name="name">Aixo milestone: customer sees own project milestones</field>
            <field name="model_id" ref="model_aixo_project_milestone"/>
            <field name="groups" eval="[(4, ref('group_desk_customer'))]"/>
            <field name="domain_force">[('project_id.partner_id.commercial_partner_id', '=', user.partner_id.commercial_partner_id.id)]</field>
        </record>
        <record id="rule_milestone_agent" model="ir.rule">
            <field name="name">Aixo milestone: agent sees milestones of their projects</field>
            <field name="model_id" ref="model_aixo_project_milestone"/>
            <field name="groups" eval="[(4, ref('group_desk_agent'))]"/>
            <field name="domain_force">[('project_id.member_ids', 'in', user.id)]</field>
        </record>
        <record id="rule_milestone_admin" model="ir.rule">
            <field name="name">Aixo milestone: admin all</field>
            <field name="model_id" ref="model_aixo_project_milestone"/>
            <field name="groups" eval="[(4, ref('group_desk_admin'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- Notifications are strictly personal (admins too) -->
        <record id="rule_notification_own" model="ir.rule">
            <field name="name">Aixo notification: own only</field>
            <field name="model_id" ref="model_aixo_notification"/>
            <field name="groups" eval="[(4, ref('group_desk_agent'))]"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
        </record>
    </data>
</odoo>
