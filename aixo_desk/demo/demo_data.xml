        <field name="classification">feature</field>
        <field name="team_id" ref="team_odoo"/>
        <field name="project_id" ref="project_014"/>
        <field name="product_id" ref="product_helpdesk"/>
        <field name="due_date" eval="(DateTime.now() + relativedelta(hours=-6)).strftime('%Y-%m-%d %H:%M:%S')"/>
