        <field name="name">Scoping call</field>
        <field name="duration">1.5</field>
    </record>
    <record id="time_103" model="aixo.time.entry">
        <field name="ticket_id" ref="ticket_103"/>
        <field name="user_id" ref="user_priya"/>
        <field name="name">Invoice template review</field>
        <field name="duration">0.75</field>
    </record>
    <record id="notif_1" model="aixo.notification">
        <field name="user_id" ref="user_bk"/>
