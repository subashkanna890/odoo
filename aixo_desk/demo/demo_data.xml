<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Teams -->
    <record id="team_tier1" model="aixo.team">
        <field name="name">Tier 1 Support</field>
        <field name="department">Support</field>
        <field name="lead_id" ref="user_priya"/>
        <field name="member_ids" eval="[(6, 0, [ref('user_priya'), ref('user_arun')])]"/>
        <field name="email">support@example.com</field>
    </record>
    <record id="team_odoo" model="aixo.team">
        <field name="name">Odoo Experts</field>
        <field name="department">Implementation</field>
        <field name="lead_id" ref="user_bk"/>
        <field name="member_ids" eval="[(6, 0, [ref('user_bk'), ref('user_rahul')])]"/>
    </record>
    <record id="team_billing" model="aixo.team">
        <field name="name">Billing Desk</field>
        <field name="department">Billing</field>
        <field name="lead_id" ref="user_arun"/>
        <field name="member_ids" eval="[(6, 0, [ref('user_arun')])]"/>
        <field name="email">billing@example.com</field>
    </record>

    <record id="holiday_diwali" model="aixo.holiday"><field name="name">Diwali</field><field name="date" eval="(DateTime.today() + relativedelta(months=2)).strftime('%Y-%m-%d')"/></record>

    <!-- Products and tags -->
    <record id="product_helpdesk" model="aixo.product"><field name="name">Helpdesk Module</field><field name="team_id" ref="team_tier1"/></record>
    <record id="product_implementation" model="aixo.product"><field name="name">Odoo Implementation</field><field name="team_id" ref="team_odoo"/></record>
    <record id="product_portal" model="aixo.product"><field name="name">Customer Portal</field><field name="team_id" ref="team_tier1"/></record>
    <record id="tag_billing" model="aixo.ticket.tag"><field name="name">billing</field></record>
    <record id="tag_odoo" model="aixo.ticket.tag"><field name="name">odoo</field></record>
    <record id="tag_urgent_customer" model="aixo.ticket.tag"><field name="name">vip</field></record>

    <!-- Projects -->
    <record id="project_014" model="aixo.project">
        <field name="name">Helpdesk Module Build</field>
        <field name="partner_id" ref="partner_zoho"/>
        <field name="date_start" eval="(DateTime.today() - relativedelta(days=1)).strftime('%Y-%m-%d')"/>
        <field name="date_due" eval="(DateTime.today() + relativedelta(days=2)).strftime('%Y-%m-%d')"/>
        <field name="state">in_progress</field>
        <field name="member_ids" eval="[(6, 0, [ref('user_bk'), ref('user_priya')])]"/>
    </record>
    <record id="project_013" model="aixo.project">
        <field name="name">Odoo 18 Migration</field>
        <field name="partner_id" ref="partner_acme"/>
        <field name="date_start" eval="(DateTime.today() - relativedelta(days=28)).strftime('%Y-%m-%d')"/>
        <field name="date_due" eval="(DateTime.today() + relativedelta(days=17)).strftime('%Y-%m-%d')"/>
        <field name="state">in_progress</field>
        <field name="member_ids" eval="[(6, 0, [ref('user_bk'), ref('user_arun'), ref('user_rahul')])]"/>
    </record>
    <record id="project_012" model="aixo.project">
        <field name="name">Customer Portal Revamp</field>
        <field name="partner_id" ref="partner_brightline"/>
        <field name="date_start" eval="(DateTime.today() - relativedelta(days=8)).strftime('%Y-%m-%d')"/>
        <field name="date_due" eval="(DateTime.today() + relativedelta(days=52)).strftime('%Y-%m-%d')"/>
        <field name="state">planning</field>
        <field name="member_ids" eval="[(6, 0, [ref('user_priya'), ref('user_rahul')])]"/>
    </record>
    <record id="project_010" model="aixo.project">
        <field name="name">Warehouse Substitution Logic</field>
        <field name="partner_id" ref="partner_pillai"/>
        <field name="date_start" eval="(DateTime.today() - relativedelta(days=50)).strftime('%Y-%m-%d')"/>
        <field name="date_due" eval="(DateTime.today() - relativedelta(days=19)).strftime('%Y-%m-%d')"/>
        <field name="state">completed</field>
        <field name="member_ids" eval="[(6, 0, [ref('user_arun'), ref('user_bk')])]"/>
    </record>
    <record id="project_009" model="aixo.project">
        <field name="name">Staffing Implementation</field>
        <field name="partner_id" ref="partner_noor"/>
        <field name="date_start" eval="(DateTime.today() - relativedelta(days=90)).strftime('%Y-%m-%d')"/>
        <field name="date_due" eval="(DateTime.today() + relativedelta(days=30)).strftime('%Y-%m-%d')"/>
        <field name="state">on_hold</field>
        <field name="member_ids" eval="[(6, 0, [ref('user_rahul'), ref('user_priya'), ref('user_bk')])]"/>
    </record>

    <record id="task_014_1" model="aixo.project.task"><field name="project_id" ref="project_014"/><field name="name">UI screens</field><field name="done" eval="True"/><field name="user_id" ref="user_bk"/></record>
    <record id="task_014_2" model="aixo.project.task"><field name="project_id" ref="project_014"/><field name="name">Ticket and customer features</field><field name="done" eval="True"/><field name="user_id" ref="user_priya"/></record>
    <record id="task_014_3" model="aixo.project.task"><field name="project_id" ref="project_014"/><field name="name">Analytics</field><field name="user_id" ref="user_bk"/></record>
    <record id="task_014_4" model="aixo.project.task"><field name="project_id" ref="project_014"/><field name="name">Testing</field><field name="user_id" ref="user_priya"/></record>
    <record id="task_013_1" model="aixo.project.task"><field name="project_id" ref="project_013"/><field name="name">Data audit</field><field name="done" eval="True"/></record>
    <record id="task_013_2" model="aixo.project.task"><field name="project_id" ref="project_013"/><field name="name">Module upgrade</field></record>
    <record id="task_010_1" model="aixo.project.task"><field name="project_id" ref="project_010"/><field name="name">Substitution rules</field><field name="done" eval="True"/></record>
    <record id="milestone_014_1" model="aixo.project.milestone"><field name="project_id" ref="project_014"/><field name="name">First screens</field><field name="date" eval="(DateTime.today() - relativedelta(days=1)).strftime('%Y-%m-%d')"/><field name="reached" eval="True"/></record>
    <record id="milestone_014_2" model="aixo.project.milestone"><field name="project_id" ref="project_014"/><field name="name">Go live</field><field name="date" eval="(DateTime.today() + relativedelta(days=2)).strftime('%Y-%m-%d')"/></record>

