<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ====================================================================
         AixoDesk Sign Up & Mobile OTP Verification Page
         Minimalist Sky-Blue & Cloud-Themed Frosted-Glass Card
         ==================================================================== -->
    <template id="signup_page" name="AixoDesk Sign Up &amp; Mobile OTP Verification">
        <t t-call="web.layout">
            <t t-set="html_data" t-value="{'data-axd-mode': 'light'}"/>
            <t t-set="body_classname" t-value="'o_axd_sky_body'"/>
            <t t-set="title">Sign up | aixodesk</t>

            <!-- Direct CSS and JS for instant styling -->
            <link rel="stylesheet" type="text/css" href="/aixodesk_login/static/src/css/signup.css?v=19.0.22"/>
            <script type="text/javascript" src="/aixodesk_login/static/src/js/signup.js?v=19.0.22"/>

            <div class="o_axd_sky_viewport o_axd_auth_wrapper">
                <!-- Background Clouds along bottom -->
                <div class="o_axd_clouds_bg" aria-hidden="true"/>

                <!-- Three Thin Low-Opacity Circular Orbital Arcs Behind the Card -->
                <svg class="o_axd_orbital_arcs" viewBox="0 0 1000 1000" aria-hidden="true" preserveAspectRatio="xMidYMid slice">
                    <circle cx="500" cy="500" r="280" class="o_axd_arc arc-1"/>
                    <circle cx="500" cy="500" r="410" class="o_axd_arc arc-2"/>
                    <circle cx="500" cy="500" r="550" class="o_axd_arc arc-3"/>
                </svg>

                <!-- Top-Left Branding Header -->
                <header class="o_axd_top_brand">
                    <t t-call="aixodesk_login.brand_header"/>
                </header>

                <!-- Centered Glass Card Container -->
                <main class="o_axd_card_container">
                    <div class="o_axd_signup_glass_card">

                        <!-- ============================================== -->
                        <!-- STEP 1: CREATE AN ACCOUNT                      -->
                        <!-- ============================================== -->
                        <div id="axd_signup_step" t-att-class="'' if not has_pending_otp else 'd-none'">
                            <!-- Top Center Card Icon Badge: User Plus -->
                            <div class="o_axd_card_icon_badge" aria-hidden="true">
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#191A20" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                                    <circle cx="8.5" cy="7" r="4"/>
                                    <line x1="20" y1="8" x2="20" y2="14"/>
                                    <line x1="23" y1="11" x2="17" y2="11"/>
                                </svg>
                            </div>

                            <div class="o_axd_card_heading">
                                <h1>Create your account</h1>
                                <p>Start managing your support tickets with AixoDesk.</p>
                            </div>

                            <!-- Alert Box -->
                            <div id="axd_signup_alert" class="alert alert-danger o_axd_alert" style="display: none;" role="alert">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                                <span class="o_axd_alert_msg"/>
                            </div>

                            <form id="axd_signup_form" novalidate="novalidate">
                                <!-- First name & Last name Side by Side -->
                                <div class="o_axd_name_row mb-3">
                                    <div class="o_axd_field">
                                        <label for="first_name" class="form-label">First name <span class="text-danger">*</span></label>
                                        <div class="o_axd_input_wrap">
                                            <input type="text" id="first_name" name="first_name" placeholder="John" class="form-control o_axd_input" required="required" autocomplete="given-name" t-att-value="signup_data.get('first_name', '')"/>
                                        </div>
                                        <div class="o_axd_field_error" id="err_first_name"/>
                                    </div>
                                    <div class="o_axd_field">
                                        <label for="last_name" class="form-label">Last name <span class="text-danger">*</span></label>
                                        <div class="o_axd_input_wrap">
                                            <input type="text" id="last_name" name="last_name" placeholder="Doe" class="form-control o_axd_input" required="required" autocomplete="family-name" t-att-value="signup_data.get('last_name', '')"/>
                                        </div>
                                        <div class="o_axd_field_error" id="err_last_name"/>
                                    </div>
                                </div>

                                <!-- Email address -->
                                <div class="o_axd_field_group mb-3">
                                    <label for="signup_email" class="form-label">Email address <span class="text-danger">*</span></label>
                                    <div class="o_axd_input_wrap">
                                        <span class="o_axd_input_icon" aria-hidden="true">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#8F9CAE" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <rect width="20" height="16" x="2" y="4" rx="2"/>
                                                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                                            </svg>
                                        </span>
                                        <input type="email" id="signup_email" name="email" placeholder="you@company.com" class="form-control o_axd_input with-icon" required="required" autocomplete="email" t-att-value="signup_data.get('email', '')"/>
                                    </div>
                                    <div class="o_axd_field_error" id="err_email"/>
                                </div>

                                <!-- Mobile number with Country Code Selector -->
                                <div class="o_axd_field_group mb-3">
                                    <label for="signup_mobile" class="form-label">Mobile number <span class="text-danger">*</span></label>
                                    <div class="o_axd_phone_group">
                                        <!-- Country Selector Trigger -->
                                        <div class="o_axd_country_picker" id="axd_country_picker" tabindex="0" role="combobox" aria-haspopup="listbox" aria-expanded="false" aria-label="Select Country Code">
                                            <span class="o_axd_country_flag" id="axd_selected_flag">
                                                <svg class="o_axd_flag_svg" width="20" height="14" viewBox="0 0 30 20" style="border-radius: 2px; overflow: hidden; display: block;">
                                                    <rect width="30" height="6.67" fill="#FF9933"/>
                                                    <rect y="6.67" width="30" height="6.67" fill="#FFFFFF"/>
                                                    <rect y="13.34" width="30" height="6.67" fill="#138808"/>
                                                    <circle cx="15" cy="10" r="2.2" fill="none" stroke="#000080" stroke-width="0.8"/>
                                                </svg>
                                            </span>
                                            <svg class="o_axd_chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="6 9 12 15 18 9"/>
                                            </svg>
                                            <span class="o_axd_country_dial" id="axd_selected_dial">+91</span>
                                            <input type="hidden" name="country_code" id="axd_country_code" value="+91"/>
                                        </div>

                                        <!-- Mobile number input -->
                                        <input type="tel" id="signup_mobile" name="mobile" class="form-control o_axd_input o_axd_phone_input" placeholder="9876543210" required="required" autocomplete="tel-national" inputmode="numeric" t-att-value="signup_data.get('mobile', '')"/>

                                        <!-- Country Dropdown Menu -->
                                        <div class="o_axd_country_dropdown" id="axd_country_dropdown" role="listbox" style="display: none;">
                                            <t t-foreach="countries" t-as="c">
                                                <div class="o_axd_country_item" t-att-data-code="c['code']" t-att-data-dial="c['dial']" t-att-data-flag="c['flag']" role="option">
                                                    <span class="o_axd_item_flag" t-esc="c['flag']"/>
                                                    <span class="o_axd_item_name" t-esc="c['name']"/>
                                                    <span class="o_axd_item_dial" t-esc="c['dial']"/>
                                                </div>
                                            </t>
                                        </div>
                                    </div>
                                    <div class="o_axd_field_error" id="err_mobile"/>
                                </div>

                                <!-- Terms and consent checkbox -->
                                <div class="o_axd_terms_row mb-4">
                                    <label class="o_axd_checkbox_label">
                                        <input type="checkbox" id="signup_terms" name="terms" required="required" checked="checked" class="o_axd_checkbox"/>
                                        <span class="o_axd_consent_text">
                                            I agree to the <a href="javascript:void(0);" class="o_axd_link" id="axd_link_terms">Terms of Service</a> and <a href="javascript:void(0);" class="o_axd_link" id="axd_link_privacy">Privacy Policy</a>.
                                        </span>
                                    </label>
                                    <div class="o_axd_field_error" id="err_terms"/>
                                </div>

                                <!-- Submit Continue Button -->
                                <div class="o_axd_btn_wrap mb-3">
                                    <button type="submit" class="btn o_axd_submit_btn" id="axd_btn_continue">
                                        <span class="o_axd_btn_spinner" style="display: none;"/>
                                        <span class="o_axd_btn_label">Continue <span class="o_axd_arrow">&#8594;</span></span>
                                    </button>
                                </div>

                                <!-- Sign in footer link -->
                                <div class="o_axd_signin_prompt">
                                    <span>Already have an account?</span>
                                    <a href="/web/login" class="o_axd_signin_link">Sign in</a>
                                </div>
                            </form>
                        </div>

                        <!-- ============================================== -->
                        <!-- STEP 2: MOBILE OTP VERIFICATION                -->
                        <!-- ============================================== -->
                        <div id="axd_otp_step" t-att-class="'' if has_pending_otp else 'd-none'">
                            <!-- Top Center Card Icon Badge: Shield Check -->
                            <div class="o_axd_card_icon_badge" aria-hidden="true">
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#191A20" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                                    <path d="m9 12 2 2 4-4"/>
                                </svg>
                            </div>

                            <div class="o_axd_card_heading">
                                <h1>Verify mobile number</h1>
                                <p class="o_axd_otp_desc">We've sent a 4-digit verification code to
                                    <span class="o_axd_phone_display">
                                        <strong id="axd_target_phone" t-esc="signup_data.get('full_phone', '+91 9360476962')"/>
                                        <button type="button" id="axd_btn_edit_phone" class="o_axd_edit_btn" title="Edit mobile number" aria-label="Edit mobile number">Edit</button>
                                    </span>
                                </p>
                            </div>

                            <!-- Alert Box -->
                            <div id="axd_otp_alert" class="alert alert-danger o_axd_alert" style="display: none;" role="alert">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                                <span class="o_axd_alert_msg"/>
                            </div>

                            <!-- 4-Digit OTP Slots -->
                            <div class="o_axd_otp_container mb-4">
                                <div class="o_axd_otp_slots" id="axd_otp_slots">
                                    <input type="text" class="o_axd_otp_slot" maxlength="1" inputmode="numeric" pattern="[0-9]*" aria-label="Digit 1" autocomplete="one-time-code" data-index="0" autofocus="autofocus"/>
                                    <input type="text" class="o_axd_otp_slot" maxlength="1" inputmode="numeric" pattern="[0-9]*" aria-label="Digit 2" data-index="1"/>
                                    <input type="text" class="o_axd_otp_slot" maxlength="1" inputmode="numeric" pattern="[0-9]*" aria-label="Digit 3" data-index="2"/>
                                    <input type="text" class="o_axd_otp_slot" maxlength="1" inputmode="numeric" pattern="[0-9]*" aria-label="Digit 4" data-index="3"/>
                                </div>
                            </div>

                            <!-- Resend Timer Row -->
                            <div class="o_axd_resend_wrap mb-4">
                                <span class="o_axd_resend_prompt">Didn't receive the code? </span>
                                <span class="o_axd_resend_countdown" id="axd_resend_countdown">
                                    Resend in <strong id="axd_resend_timer"><t t-esc="resend_in or 30"/></strong>s
                                </span>
                                <button type="button" class="o_axd_resend_btn" id="axd_btn_resend" style="display: none;">Resend code</button>
                            </div>

                            <!-- Verify & Continue Button -->
                            <div class="o_axd_btn_wrap mb-3">
                                <button type="button" class="btn o_axd_submit_btn" id="axd_btn_verify">
                                    <span class="o_axd_btn_spinner" style="display: none;"/>
                                    <span class="o_axd_btn_label">Verify &amp; Continue <span class="o_axd_arrow">&#8594;</span></span>
                                </button>
                            </div>

                            <!-- Back Navigation -->
                            <div class="text-center">
                                <button type="button" class="btn btn-link o_axd_back_btn" id="axd_btn_back">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                        <line x1="19" y1="12" x2="5" y2="12"/>
                                        <polyline points="12 19 5 12 12 5"/>
                                    </svg>
                                    <span>Back</span>
                                </button>
                            </div>
                        </div>

                    </div>
                </main>

                <!-- Terms Modal -->
                <div id="axd_modal_terms" class="o_axd_modal" role="dialog" aria-modal="true" aria-labelledby="terms_title" style="display: none;">
                    <div class="o_axd_modal_content">
                        <div class="o_axd_modal_header">
                            <h3 id="terms_title">Terms of Service</h3>
                            <button type="button" class="o_axd_modal_close" data-close="terms">&#215;</button>
                        </div>
                        <div class="o_axd_modal_body">
                            <p>Welcome to AixoDesk. By creating an account, you agree to comply with our Terms of Service. You are responsible for safeguarding your login credentials and maintaining the accuracy of your account information. AixoDesk provides automated ticket resolution, SLA tracking, and team collaboration tooling.</p>
                            <p>Usage of our services must adhere to all applicable international data handling standards and our acceptable use policies.</p>
                        </div>
                        <div class="o_axd_modal_footer">
                            <button type="button" class="btn o_axd_submit_btn" data-close="terms" style="height: 38px;">I Understand</button>
                        </div>
                    </div>
                </div>

                <!-- Privacy Modal -->
                <div id="axd_modal_privacy" class="o_axd_modal" role="dialog" aria-modal="true" aria-labelledby="privacy_title" style="display: none;">
                    <div class="o_axd_modal_content">
                        <div class="o_axd_modal_header">
                            <h3 id="privacy_title">Privacy Policy</h3>
                            <button type="button" class="o_axd_modal_close" data-close="privacy">&#215;</button>
                        </div>
                        <div class="o_axd_modal_body">
                            <p>AixoDesk respects your privacy. We collect your name, email, and mobile number solely for authentication, multi-factor verification, and helpdesk operations. We do not sell or lease your personal information to third parties.</p>
                            <p>All verification records and temporary one-time passwords expire automatically and are processed securely.</p>
                        </div>
                        <div class="o_axd_modal_footer">
                            <button type="button" class="btn o_axd_submit_btn" data-close="privacy" style="height: 38px;">I Understand</button>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
