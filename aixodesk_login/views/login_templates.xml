<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ====================================================================
         Shared AixoDesk Brand Header Component
         Placed top-left across both Login and Sign Up pages
         ==================================================================== -->
    <template id="brand_header" name="AixoDesk Brand Header">
        <a href="/" class="o_axd_brand_header" aria-label="aixodesk home">
            <span class="o_axd_brand_logo">
                <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 5h16v11H9l-5 4z"/>
                    <path d="M8 9.5h8M8 12.5h5"/>
                </svg>
            </span>
            <span class="o_axd_brand_name">aixodesk</span>
        </a>
    </template>

    <!-- ====================================================================
         AixoDesk Sky Cloud Login Layout
         Centered frosted-glass authentication card with soft sky gradient,
         realistic clouds at bottom, and concentric orbital arcs
         ==================================================================== -->
    <template id="aixodesk_login_layout" inherit_id="web.login_layout" name="AixoDesk Sky Cloud Login Layout" priority="99">
        <xpath expr="t[@t-call]" position="replace">
            <t t-call="web.frontend_layout">
                <t t-set="html_data" t-value="{'style': 'height: 100%;'}"/>
                <t t-set="body_classname" t-value="'o_axd_sky_body'"/>
                <t t-set="no_header" t-value="True"/>
                <t t-set="no_footer" t-value="True"/>
                <div class="o_axd_sky_viewport">
                    <!-- Stylesheet and Script -->
                    <link rel="stylesheet" type="text/css" href="/aixodesk_login/static/src/css/login.css?v=19.0.22"/>
                    <script type="text/javascript" src="/aixodesk_login/static/src/js/login_theme.js?v=19.0.22"/>

                    <!-- Background: Soft Sky Gradient + Realistic Clouds along bottom -->
                    <div class="o_axd_clouds_bg" aria-hidden="true"/>

                    <!-- Three Thin Low-Opacity Circular Orbital Arcs Behind the Card -->
                    <svg class="o_axd_orbital_arcs" viewBox="0 0 1000 1000" aria-hidden="true" preserveAspectRatio="xMidYMid slice">
                        <circle cx="500" cy="500" r="280" class="o_axd_arc arc-1"/>
                        <circle cx="500" cy="500" r="410" class="o_axd_arc arc-2"/>
                        <circle cx="500" cy="500" r="550" class="o_axd_arc arc-3"/>
                    </svg>

                    <!-- Top-Left Branding Identity -->
                    <header class="o_axd_top_brand">
                        <t t-call="aixodesk_login.brand_header"/>
                    </header>

                    <!-- Centered Frosted-Glass Card -->
                    <main class="o_axd_card_container">
                        <div class="o_axd_glass_card">
                            <t t-out="0"/>
                        </div>
                    </main>
                </div>
            </t>
        </xpath>
    </template>

    <!-- ====================================================================
         AixoDesk Centered Sign in Form (Reference-Matched Minimalist UI)
         ==================================================================== -->
    <template id="aixodesk_login_form_custom" inherit_id="web.login" name="AixoDesk Refined Sign in Form" priority="99">
        <xpath expr="//t[@t-call='web.login_layout']" position="replace">
            <t t-call="web.login_layout">
                <div class="oe_structure" id="oe_structure_login_top"/>

                <!-- Top Center Card Icon Badge: Login Arrow -->
                <div class="o_axd_card_icon_badge" aria-hidden="true">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#191A20" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>
                        <polyline points="10 17 15 12 10 7"/>
                        <line x1="15" y1="12" x2="3" y2="12"/>
                    </svg>
                </div>

                <!-- Card Heading & Subtitle -->
                <div class="o_axd_card_heading">
                    <h1>Sign in to AixoDesk</h1>
                    <p>Your support workspace, all in one place.</p>
                </div>

                <!-- Authentication Form -->
                <form t-attf-class="oe_login_form #{'' if login else 'd-none'}" role="form" t-attf-action="/web/login" method="post" onsubmit="this.action = '/web/login' + location.hash" data-captcha="login">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                    <!-- Multi-database selector -->
                    <div class="o_axd_field_group mb-3" t-if="databases and len(databases) &gt; 1">
                        <label for="db" class="form-label">Database</label>
                        <div class="o_axd_input_wrap">
                            <input type="text" name="db" t-att-value="request.db" id="db" class="form-control o_axd_input" required="required" readonly="readonly"/>
                        </div>
                    </div>

                    <!-- Email Field with Envelope Icon -->
                    <div class="o_axd_field_group mb-3">
                        <div class="o_axd_input_wrap">
                            <span class="o_axd_input_icon" aria-hidden="true">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#8F9CAE" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect width="20" height="16" x="2" y="4" rx="2"/>
                                    <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                                </svg>
                            </span>
                            <input type="text" placeholder="Email" name="login" t-att-value="login" id="login" class="form-control o_axd_input with-icon" required="required" autocapitalize="off" autocomplete="username" aria-label="Email"/>
                        </div>
                    </div>

                    <!-- Password Field with Lock Icon & Eye Toggle -->
                    <div class="o_axd_field_group mb-2">
                        <div class="o_axd_input_wrap o_axd_password_wrap">
                            <span class="o_axd_input_icon" aria-hidden="true">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#8F9CAE" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
                                    <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                                </svg>
                            </span>
                            <input type="password" placeholder="Password" name="password" id="password" class="form-control o_axd_input with-icon with-eye" required="required" autocomplete="current-password" maxlength="4096" aria-label="Password"/>
                            <button type="button" class="o_axd_eye_toggle" id="axd_eye_toggle" aria-label="Toggle password visibility" title="Show password" tabindex="-1">
                                <!-- Eye Open Icon -->
                                <svg class="o_axd_eye_open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#8F9CAE" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7z"/>
                                    <circle cx="12" cy="12" r="3"/>
                                </svg>
                                <!-- Eye Off Icon (slashed) -->
                                <svg class="o_axd_eye_slash" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#8F9CAE" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
                                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/>
                                    <line x1="1" y1="1" x2="23" y2="23"/>
                                </svg>
                            </button>
                        </div>
                    </div>

                    <!-- Forgot Password Link -->
                    <div class="o_axd_forgot_row mb-4">
                        <a class="o_axd_forgot_link" tabindex="1" t-attf-href="/web/reset_password?{{ keep_query() }}">Forgot password?</a>
                    </div>

                    <!-- Alerts (Errors / Status) -->
                    <div class="alert alert-danger o_axd_alert" t-if="error" role="alert">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                        <span><t t-esc="error"/></span>
                    </div>
                    <div class="alert alert-success o_axd_alert" t-if="message" role="status">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                        <span><t t-esc="message"/></span>
                    </div>

                    <!-- Primary Submit Button -->
                    <div class="o_axd_btn_wrap mb-3">
                        <button type="submit" class="btn o_axd_submit_btn">Sign in</button>
                    </div>

                    <!-- Superuser debug button -->
                    <t t-if="debug">
                        <div class="text-center mb-2">
                            <button type="submit" name="redirect" value="/web/become" class="btn btn-link btn-sm text-muted">Log in as superuser</button>
                        </div>
                    </t>

                    <!-- OAuth Provider Buttons (Conditional - only if configured) -->
                    <t t-call="web.login_oauth"/>

                    <!-- Sign Up Navigation Prompt -->
                    <div class="o_axd_signup_prompt">
                        <span class="o_axd_signup_text">Don't have an account?</span>
                        <a t-attf-href="/web/signup?{{ keep_query() }}" class="o_axd_signup_link">Sign up now</a>
                    </div>

                    <input type="hidden" name="type" value="password"/>
                    <input type="hidden" name="redirect" t-att-value="redirect"/>
                </form>
                <div class="oe_structure" id="oe_structure_login_bottom"/>
            </t>
        </xpath>
    </template>
</odoo>
