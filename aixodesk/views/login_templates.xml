<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ====================================================================
         AixoDesk Portal Layout Shell - Reference-Matched UI
         Clean, minimal white composition without footer or trust bar
         ==================================================================== -->
    <template id="portal_layout" name="AixoDesk Portal Layout Shell">
        <div class="aixodesk-portal-viewport">
            <!-- Explicit direct asset loading for instant styling -->
            <link rel="stylesheet" type="text/css" href="/aixodesk/static/src/css/login.css"/>
            <script type="text/javascript" src="/aixodesk/static/src/js/login.js"/>

            <!-- Natural Ambient Sunlight Overlay -->
            <div class="aixodesk-ambient-light"/>

            <!-- Top-Left Brand Identity (~40px left, ~65px top) -->
            <header class="aixodesk-brand-header">
                <a href="/" title="aixodesk - Support, simplified.">
                    <img src="/aixodesk/static/src/img/aixodesk-logo-exact.png" alt="aixodesk" class="aixo-brand-logo"/>
                </a>
            </header>

            <!-- Decorative Outer Graphics (Clipped by viewport boundaries) -->
            <div class="aixodesk-decor-layer" aria-hidden="true">
                <!-- Top-Left: Orange binder clip & stationery -->
                <img src="/aixodesk/static/src/img/decor-clip-target.png" alt="" class="aixo-decor-clip login-decoration--binder"/>
                <!-- Mid-Left: Partially clipped document & currency badges -->
                <img src="/aixodesk/static/src/img/decor-doc-target.png" alt="" class="aixo-decor-ticket login-decoration--document"/>
                <!-- Top-Right: $100 currency bill note -->
                <img src="/aixodesk/static/src/img/decor-bill-target.png" alt="" class="aixo-decor-bill login-decoration--banknote"/>
                <!-- Right-Edge: Group of floating finance cards (Invoice card, circular loop icon, pie chart, jewel) -->
                <img src="/aixodesk/static/src/img/decor-right-target.png" alt="" class="aixo-decor-invoice login-decoration--card"/>
                <!-- Lower-Right of login form: Silver Paperclip -->
                <img src="/aixodesk/static/src/img/decor-paperclip-target.png" alt="" class="aixo-decor-paperclip login-decoration--paperclip"/>
            </div>

            <!-- Main Centered Content Section -->
            <main class="aixodesk-main-content">
                <div class="aixodesk-form-column">
                    <t t-out="0"/>
                </div>
            </main>

            <!-- Reusable Modal for Notices (OAuth, Sign up, Recovery) -->
            <div id="aixoNoticeModal" class="aixodesk-modal-overlay" role="dialog" aria-modal="true" aria-labelledby="aixoModalTitle">
                <div class="aixodesk-modal-card">
                    <h3 id="aixoModalTitle">Notice</h3>
                    <p id="aixoModalDesc">Information</p>
                    <button type="button" class="aixodesk-modal-btn">Got it</button>
                </div>
            </div>
        </div>
    </template>

    <!-- ====================================================================
         Override web.login_layout with AixoDesk Portal Layout
         ==================================================================== -->
    <template id="aixodesk_login_layout" inherit_id="web.login_layout" name="AixoDesk Portal Login Layout" priority="35">
        <xpath expr="t[@t-call]" position="replace">
            <t t-call="website.layout">
                <t t-set="no_header" t-value="True"/>
                <t t-set="no_footer" t-value="True"/>
                <t t-set="body_classname" t-value="'aixodesk-portal-body'"/>
                <t t-call="aixodesk.portal_layout">
                    <t t-out="0"/>
                </t>
            </t>
        </xpath>
    </template>

    <!-- ====================================================================
         Override web.login with Reference-Matched UI Form
         ==================================================================== -->
    <template id="aixodesk_login_form" inherit_id="web.login" name="AixoDesk Login Form" priority="35">
        <xpath expr="//t[@t-call='web.login_layout']" position="replace">
            <t t-call="web.login_layout">
                <!-- Welcome Heading with Waving Hand Emoji -->
                <h1 class="aixodesk-heading">Welcome back <span class="aixodesk-wave-emoji">&#128075;</span></h1>

                <!-- Google Authentication Button -->
                <a t-att-href="google_auth_link or '#'" 
                   t-att-data-unconfigured="'false' if google_oauth_configured else 'true'"
                   class="aixodesk-google-btn" 
                   role="button"
                   aria-label="Continue with Google">
                    <img src="/aixodesk/static/src/img/google-icon.svg" alt="Google" class="google-icon"/>
                    <span>Continue with Google</span>
                </a>

                <!-- Thin Light Divider -->
                <hr class="aixodesk-divider"/>

                <!-- Feedback / Error Alerts -->
                <div class="aixodesk-alert aixodesk-alert-danger" t-if="error" role="alert">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;">
                        <circle cx="12" cy="12" r="10"/>
                        <line x1="12" y1="8" x2="12" y2="12"/>
                        <line x1="12" y1="16" x2="12.01" y2="16"/>
                    </svg>
                    <span><t t-esc="error"/></span>
                </div>
                <div class="aixodesk-alert aixodesk-alert-success" t-if="message" role="status">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                        <polyline points="22 4 12 14.01 9 11.01"/>
                    </svg>
                    <span><t t-esc="message"/></span>
                </div>

                <!-- Email & Password Form -->
                <form class="aixodesk-form oe_login_form" role="form" t-attf-action="/web/login" method="post" onsubmit="this.action = '/web/login' + location.hash" data-captcha="login">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                    <!-- Database selection if multi-database -->
                    <div class="aixodesk-field-group" t-if="databases and len(databases) &gt; 1">
                        <label for="db" class="aixodesk-label">Database</label>
                        <input type="text" name="db" t-att-value="request.db" id="db" class="aixodesk-input" required="required" readonly="readonly"/>
                    </div>

                    <!-- Email Input -->
                    <div class="aixodesk-field-group">
                        <input type="email" 
                               placeholder="Email" 
                               name="login" 
                               t-att-value="login" 
                               id="login" 
                               class="aixodesk-input" 
                               required="required" 
                               autocapitalize="off" 
                               autocomplete="username" 
                               aria-label="Email"/>
                    </div>

                    <!-- Password Input with Toggle -->
                    <div class="aixodesk-field-group">
                        <div class="aixodesk-password-wrapper">
                            <input type="password" 
                                   placeholder="Password" 
                                   name="password" 
                                   id="password" 
                                   class="aixodesk-input" 
                                   required="required" 
                                   autocomplete="current-password" 
                                   maxlength="4096" 
                                   aria-label="Password"/>
                            <button type="button" class="aixodesk-pwd-toggle" aria-label="Toggle password visibility">
                                <!-- Eye Open -->
                                <svg class="icon-eye" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                    <circle cx="12" cy="12" r="3"/>
                                </svg>
                                <!-- Eye Closed -->
                                <svg class="icon-eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="display:none;">
                                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/>
                                    <line x1="1" y1="1" x2="23" y2="23"/>
                                </svg>
                            </button>
                        </div>
                    </div>

                    <!-- Primary Submit Button: Continue -->
                    <button type="submit" class="aixodesk-btn-continue">
                        <span class="aixodesk-spinner"/>
                        <span>Continue</span>
                    </button>

                    <input type="hidden" name="type" value="password"/>
                    <input type="hidden" name="redirect" t-att-value="redirect"/>
                </form>

                <!-- Forgot Password Link -->
                <a t-if="reset_password_enabled" t-attf-href="/web/reset_password?{{ keep_query() }}" class="aixodesk-forgot-link">
                    Forgot password
                </a>
                <a t-else="" href="javascript:void(0);" data-notice-type="reset_disabled" class="aixodesk-forgot-link aixodesk-notice-trigger">
                    Forgot password
                </a>

                <!-- Sign Up Section -->
                <div class="aixodesk-signup-line">
                    <span>Don't have an account?</span>
                    <a t-if="signup_enabled" t-attf-href="/web/signup?{{ keep_query() }}" class="aixodesk-signup-link">Sign up</a>
                    <a t-else="" href="javascript:void(0);" data-notice-type="signup_disabled" class="aixodesk-signup-link aixodesk-notice-trigger">Sign up</a>
                </div>
            </t>
        </xpath>
    </template>

    <!-- ====================================================================
         Override auth_signup.reset_password Form
         ==================================================================== -->
    <template id="aixodesk_reset_password" inherit_id="auth_signup.reset_password" name="AixoDesk Reset Password" priority="35">
        <xpath expr="//t[@t-call='web.login_layout']" position="replace">
            <t t-call="web.login_layout">
                <h1 class="aixodesk-heading" style="font-size: 26px;">Reset Password <span class="aixodesk-wave-emoji">&#128273;</span></h1>
                <p style="text-align: center; font-size: 13.5px; color: #74777D; margin: -14px 0 22px 0;">
                    Enter your account email to receive reset instructions
                </p>

                <div class="aixodesk-alert aixodesk-alert-success" t-if="message" role="status">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                        <polyline points="22 4 12 14.01 9 11.01"/>
                    </svg>
                    <span><t t-esc="message"/></span>
                </div>
                <div class="aixodesk-alert aixodesk-alert-danger" t-if="error" role="alert">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;">
                        <circle cx="12" cy="12" r="10"/>
                        <line x1="12" y1="8" x2="12" y2="12"/>
                        <line x1="12" y1="16" x2="12.01" y2="16"/>
                    </svg>
                    <span><t t-esc="error"/></span>
                </div>

                <form class="aixodesk-form oe_reset_password_form" role="form" method="post" t-if="not message" data-captcha="password_reset">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                    <t t-if="token and not invalid_token">
                        <div class="aixodesk-field-group">
                            <div class="aixodesk-password-wrapper">
                                <input type="password" name="password" id="password" class="aixodesk-input" required="required" placeholder="New Password" aria-label="New Password"/>
                                <button type="button" class="aixodesk-pwd-toggle" aria-label="Toggle password visibility">
                                    <svg class="icon-eye" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                        <circle cx="12" cy="12" r="3"/>
                                    </svg>
                                    <svg class="icon-eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="display:none;">
                                        <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/>
                                        <line x1="1" y1="1" x2="23" y2="23"/>
                                    </svg>
                                </button>
                            </div>
                        </div>
                        <div class="aixodesk-field-group">
                            <div class="aixodesk-password-wrapper">
                                <input type="password" name="confirm_password" id="confirm_password" class="aixodesk-input" required="required" placeholder="Confirm Password" aria-label="Confirm Password"/>
                                <button type="button" class="aixodesk-pwd-toggle" aria-label="Toggle password visibility">
                                    <svg class="icon-eye" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                        <circle cx="12" cy="12" r="3"/>
                                    </svg>
                                    <svg class="icon-eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="display:none;">
                                        <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/>
                                        <line x1="1" y1="1" x2="23" y2="23"/>
                                    </svg>
                                </button>
                            </div>
                        </div>
                    </t>

                    <t t-if="not token">
                        <div class="aixodesk-field-group">
                            <input type="email" name="login" t-att-value="login" id="login" class="aixodesk-input" placeholder="Email" autofocus="autofocus" required="required" autocapitalize="off" aria-label="Email"/>
                        </div>
                    </t>

                    <button type="submit" class="aixodesk-btn-continue">
                        <span class="aixodesk-spinner"/>
                        <span>Send Reset Link</span>
                    </button>
                </form>

                <a t-attf-href="/web/login?{{ keep_query() }}" class="aixodesk-forgot-link" style="margin-top: 22px;">
                    &#8592; Back to Login
                </a>
            </t>
        </xpath>
    </template>

    <!-- ====================================================================
         Override auth_signup.signup Form
         ==================================================================== -->
    <template id="aixodesk_signup" inherit_id="auth_signup.signup" name="AixoDesk Sign Up" priority="35">
        <xpath expr="//t[@t-call='web.login_layout']" position="replace">
            <t t-call="web.login_layout">
                <h1 class="aixodesk-heading" style="font-size: 26px;">Create Account <span class="aixodesk-wave-emoji">&#128640;</span></h1>
                <p style="text-align: center; font-size: 13.5px; color: #74777D; margin: -14px 0 22px 0;">
                    Get started with your AixoDesk helpdesk account
                </p>

                <div class="aixodesk-alert aixodesk-alert-danger" t-if="error" role="alert">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;">
                        <circle cx="12" cy="12" r="10"/>
                        <line x1="12" y1="8" x2="12" y2="12"/>
                        <line x1="12" y1="16" x2="12.01" y2="16"/>
                    </svg>
                    <span><t t-esc="error"/></span>
                </div>

                <form class="aixodesk-form oe_signup_form" role="form" method="post" t-if="not message" data-captcha="signup">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                    <div class="aixodesk-field-group">
                        <input type="text" name="name" t-att-value="name" id="name" class="aixodesk-input" placeholder="Full Name" autofocus="autofocus" required="required" aria-label="Full Name"/>
                    </div>

                    <div class="aixodesk-field-group">
                        <input type="email" name="login" t-att-value="login" id="login" class="aixodesk-input" placeholder="Work Email" required="required" autocapitalize="off" aria-label="Work Email"/>
                    </div>

                    <div class="aixodesk-field-group">
                        <div class="aixodesk-password-wrapper">
                            <input type="password" name="password" id="password" class="aixodesk-input" required="required" placeholder="Password" aria-label="Password"/>
                            <button type="button" class="aixodesk-pwd-toggle" aria-label="Toggle password visibility">
                                <svg class="icon-eye" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                    <circle cx="12" cy="12" r="3"/>
                                </svg>
                                <svg class="icon-eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="display:none;">
                                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/>
                                    <line x1="1" y1="1" x2="23" y2="23"/>
                                </svg>
                            </button>
                        </div>
                    </div>

                    <div class="aixodesk-field-group">
                        <div class="aixodesk-password-wrapper">
                            <input type="password" name="confirm_password" id="confirm_password" class="aixodesk-input" required="required" placeholder="Confirm Password" aria-label="Confirm Password"/>
                            <button type="button" class="aixodesk-pwd-toggle" aria-label="Toggle password visibility">
                                <svg class="icon-eye" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                    <circle cx="12" cy="12" r="3"/>
                                </svg>
                                <svg class="icon-eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="display:none;">
                                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/>
                                    <line x1="1" y1="1" x2="23" y2="23"/>
                                </svg>
                            </button>
                        </div>
                    </div>

                    <input type="hidden" name="redirect" t-att-value="redirect"/>
                    <input type="hidden" name="token" t-att-value="token"/>

                    <button type="submit" class="aixodesk-btn-continue">
                        <span class="aixodesk-spinner"/>
                        <span>Create Account</span>
                    </button>
                </form>

                <div class="aixodesk-signup-line" style="margin-top: 22px;">
                    <span>Already have an account?</span>
                    <a t-attf-href="/web/login?{{ keep_query() }}" class="aixodesk-signup-link">Log in</a>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
