<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_helpdesk" model="ir.ui.view">
        <field name="name">hr.employee.form.helpdesk</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <!-- Place Helpdesk stage page right after hr_settings in notebook headers -->
            <xpath expr="//page[@name='hr_settings']" position="after">
                <page name="helpdesk" string="Helpdesk">
                    <!-- 1. Employee Password Settings -->
                    <group string="Password &amp; Security Settings" name="helpdesk_password_settings">
                        <group>
                            <field name="helpdesk_username" string="Helpdesk Username" readonly="1"/>
                            <label for="helpdesk_new_password" string="Set Password"/>
                            <div class="o_row align-items-center">
                                <field name="helpdesk_new_password" widget="password" placeholder="Enter new password..." autocomplete="new-password" class="flex-grow-1"/>
                                <button name="action_set_employee_password" string="Set Password" type="object" class="btn-primary ms-2" icon="fa-key"/>
                            </div>
                            <field name="helpdesk_password_updated" string="Password Last Changed"/>
                            <field name="notes" string="About Me / Bio" placeholder="Brief introduction or support bio..."/>
                            <field name="helpdesk_user_id" invisible="1"/>
                            <field name="helpdesk_password" invisible="1"/>
                        </group>
                        <group>
                            <field name="helpdesk_password_status" widget="badge" decoration-success="helpdesk_password_status == 'active'" decoration-warning="helpdesk_password_status == 'temporary'" decoration-danger="helpdesk_password_status == 'expired'"/>
                        </group>
                    </group>

                    <!-- 2. Login Active Sessions -->
                    <div class="mt-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h4 class="h6 fw-bold text-dark mb-0">
                                <i class="fa fa-history text-success me-1"/> Employee Login Sessions History
                            </h4>
                        </div>
                        <field name="helpdesk_session_ids">
                            <list string="Login Sessions History" editable="bottom">
                                <field name="session_token" string="Session ID"/>
                                <field name="client_type" widget="badge" decoration-info="client_type == 'console'" decoration-primary="client_type == 'web'" decoration-warning="client_type == 'mobile'"/>
                                <field name="ip_address" string="IP Address"/>
                                <field name="location" string="Approx. Location"/>
                                <field name="login_date" string="Login Time"/>
                                <field name="last_activity" string="Last Active"/>
                                <field name="logout_date" string="Logout Time"/>
                                <field name="status" widget="badge" decoration-success="status == 'active'" decoration-danger="status == 'logged_out'" decoration-warning="status == 'idle'" decoration-muted="status == 'expired'"/>
                                <button name="action_terminate_session" string="Terminate" type="object" icon="fa-times-circle" class="btn-link text-danger" title="Terminate Session" invisible="status in ['logged_out', 'expired']"/>
                            </list>
                        </field>
                    </div>

                    <!-- 3. Log in Device Sessions -->
                    <div class="mt-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h4 class="h6 fw-bold text-dark mb-0">
                                <i class="fa fa-desktop text-primary me-1"/> Log in Device Sessions
                            </h4>
                        </div>
                        <field name="helpdesk_device_ids">
                            <list string="Authorized Devices" editable="bottom">
                                <field name="device_name" string="Device Name"/>
                                <field name="device_type" widget="badge" decoration-info="device_type == 'desktop'" decoration-warning="device_type == 'mobile'"/>
                                <field name="operating_system" string="Operating System"/>
                                <field name="browser" string="Browser"/>
                                <field name="location" string="Location"/>
                                <field name="ip_address" string="IP Address"/>
                                <field name="last_active" string="Last Active"/>
                                <field name="is_trusted" widget="boolean_toggle" string="Trusted"/>
                                <field name="status" widget="badge" decoration-success="status == 'logged_in'" decoration-danger="status == 'logged_out'"/>
                                <button name="action_logout_device" string="Log Out" type="object" icon="fa-sign-out" class="btn-link text-danger" title="Sign Out Device" invisible="status == 'logged_out'"/>
                            </list>
                        </field>
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
