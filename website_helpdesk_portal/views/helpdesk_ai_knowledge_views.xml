<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_helpdesk_ai_knowledge_tree" model="ir.ui.view">
        <field name="name">helpdesk.ai.knowledge.tree</field>
        <field name="model">helpdesk.ai.knowledge</field>
        <field name="arch" type="xml">
            <list string="Helpdesk AI Knowledge Base">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="document_type"/>
                <field name="access_scope" widget="badge"/>
                <field name="file_name"/>
                <field name="is_indexed"/>
                <field name="write_date"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_helpdesk_ai_knowledge_form" model="ir.ui.view">
        <field name="name">helpdesk.ai.knowledge.form</field>
        <field name="model">helpdesk.ai.knowledge</field>
        <field name="arch" type="xml">
            <form string="Knowledge Base Document">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Document Title"/>
                        <h1>
                            <field name="name" placeholder="e.g. Printer Setup &amp; Network Troubleshooting Guide"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Classification &amp; Security">
                            <field name="document_type"/>
                            <field name="access_scope"/>
                            <field name="is_indexed"/>
                            <field name="source_url" placeholder="https://docs.company.com/..."/>
                        </group>
                        <group string="Attachment &amp; Links">
                            <field name="file_attachment" filename="file_name"/>
                            <field name="file_name" invisible="1"/>
                            <field name="ticket_id"/>
                            <field name="project_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Extracted &amp; Searchable Content">
                            <field name="content" placeholder="Paste or view clean markdown/text content for Gemini AI retrieval..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_helpdesk_ai_knowledge_search" model="ir.ui.view">
        <field name="name">helpdesk.ai.knowledge.search</field>
        <field name="model">helpdesk.ai.knowledge</field>
        <field name="arch" type="xml">
            <search string="Search AI Knowledge">
                <field name="name"/>
                <field name="content"/>
                <filter string="Public Scope" name="public" domain="[('access_scope', '=', 'public')]"/>
                <filter string="Employee Scope" name="employee" domain="[('access_scope', '=', 'employee')]"/>
                <filter string="PM Scope" name="pm" domain="[('access_scope', '=', 'project_manager')]"/>
                <group>
                    <filter string="Document Type" name="group_type" context="{'group_by': 'document_type'}"/>
                    <filter string="Access Scope" name="group_scope" context="{'group_by': 'access_scope'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_helpdesk_ai_knowledge" model="ir.actions.act_window">
        <field name="name">AI Knowledge Base</field>
        <field name="res_model">helpdesk.ai.knowledge</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_helpdesk_ai_knowledge_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add manuals, SOPs, FAQs and documentation to train your Helpdesk AI Assistant!
            </p>
        </field>
    </record>

    <!-- Menu Item under Helpdesk Configuration -->
    <menuitem id="menu_helpdesk_ai_knowledge"
              name="AI Knowledge Base"
              parent="menu_helpdesk_configuration_root"
              action="action_helpdesk_ai_knowledge"
              sequence="45"/>
</odoo>
