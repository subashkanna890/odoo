<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         HELPDESK STAGE MAP - LIST VIEW (MATCHING USER REQUIREMENT)
         Header: Name, Stage Key (Many2many tags).
         Removed: Helpdesk Teams, Folded.
         ============================================================ -->
    <record id="helpdesk_stage_map_view_tree" model="ir.ui.view">
        <field name="name">helpdesk.stage.map.list</field>
        <field name="model">helpdesk.stage.map</field>
        <field name="arch" type="xml">
            <list string="Stage Map" multi_edit="1" sample="1" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="stage_ids" widget="many2many_tags" string="Stage Key" options="{'no_create_edit': True}" placeholder="Select Helpdesk Stages..."/>
            </list>
        </field>
    </record>

    <!-- ============================================================
         HELPDESK STAGE MAP - FORM VIEW
         ============================================================ -->
    <record id="helpdesk_stage_map_view_form" model="ir.ui.view">
        <field name="name">helpdesk.stage.map.form</field>
        <field name="model">helpdesk.stage.map</field>
        <field name="arch" type="xml">
            <form string="Stage Map">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Stage Map Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. In Progress"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="stage_ids" widget="many2many_tags" string="Stage Key" options="{'no_create_edit': True}"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="code"/>
                            <field name="team_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            <field name="fold"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================
         HELPDESK STAGE MAP - SEARCH VIEW
         ============================================================ -->
    <record id="helpdesk_stage_map_view_search" model="ir.ui.view">
        <field name="name">helpdesk.stage.map.search</field>
        <field name="model">helpdesk.stage.map</field>
        <field name="arch" type="xml">
            <search string="Search Stage Maps">
                <field name="name"/>
                <field name="stage_ids" string="Stage Key"/>
                <field name="code"/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- ============================================================
         HELPDESK STAGE MAP - ACTION
         ============================================================ -->
    <record id="helpdesk_stage_map_action" model="ir.actions.act_window">
        <field name="name">Stage Map</field>
        <field name="res_model">helpdesk.stage.map</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="helpdesk_stage_map_view_tree"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Stage Map
            </p>
            <p>
                Stage Maps define how ticket metrics are aggregated and displayed on the Customer and Employee Helpdesk Portals.
            </p>
        </field>
    </record>

    <!-- ============================================================
         HELPDESK CONFIGURATION SUBMENU - STAGE MAP
         Positioned inside Helpdesk -> Configuration right below Stages
         ============================================================ -->
    <menuitem
        id="helpdesk_stage_map_menu"
        name="Stage Map"
        action="helpdesk_stage_map_action"
        parent="helpdesk.helpdesk_menu_config"
        sequence="4"/>

    <!-- ============================================================
         HELPDESK STAGE - INHERITED LIST VIEW (TO TRACK & BACK TRACK STAGES & IS COMPLETED)
         Adds 'To Track Stage', 'Back Track Stages', and 'Is Completed' columns right next to 'Helpdesk Teams'
         ============================================================ -->
    <record id="helpdesk_stage_view_tree_inherit_back_track" model="ir.ui.view">
        <field name="name">helpdesk.stage.list.inherit.back.track</field>
        <field name="model">helpdesk.stage</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_stage_view_tree"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='team_ids']" position="after">
                <field name="to_track_stage_ids" string="To Track Stage" widget="many2many_tags" options="{'color_field': 'color', 'no_create': True}" optional="show"/>
                <field name="back_track_stage_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_create': True}" optional="show"/>
                <field name="allow_reopen" string="Re Open" optional="show"/>
                <field name="is_completed" string="Is Completed" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- ============================================================
         HELPDESK STAGE - INHERITED FORM VIEW (TO TRACK & BACK TRACK STAGES & IS COMPLETED)
         ============================================================ -->
    <record id="helpdesk_stage_view_form_inherit_back_track" model="ir.ui.view">
        <field name="name">helpdesk.stage.form.inherit.back.track</field>
        <field name="model">helpdesk.stage</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_stage_view_form"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='team_ids']" position="after">
                <field name="to_track_stage_ids" string="To Track Stage" widget="many2many_tags" options="{'color_field': 'color', 'no_create': True}"/>
                <field name="back_track_stage_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_create': True}"/>
                <field name="is_completed" string="Is Completed"/>
            </xpath>
        </field>
    </record>

    <!-- ============================================================
         HELPDESK STAGE - COMPLETED NOTIFICATION WIZARD FORM VIEW
         ============================================================ -->
    <record id="helpdesk_stage_completed_wizard_view_form" model="ir.ui.view">
        <field name="name">helpdesk.stage.completed.wizard.form</field>
        <field name="model">helpdesk.stage.completed.wizard</field>
        <field name="arch" type="xml">
            <form string="Stage Completed Notification">
                <div class="alert alert-warning d-flex align-items-center mb-3" role="alert">
                    <i class="fa fa-exclamation-triangle fa-2x me-3" style="color: #f59e0b;"/>
                    <div>
                        <h5 class="mb-1" style="font-weight: 600;">Only One Stage Can Be Completed</h5>
                        <p class="mb-0" style="font-size: 13px;">Only one helpdesk stage can have the &quot;Is Completed&quot; condition active at a time.</p>
                    </div>
                </div>
                <group>
                    <field name="message" nolabel="1" readonly="1"/>
                </group>
                <footer>
                    <button string="Switch Completed Stage" type="object" name="action_switch_completed" class="btn-primary"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
